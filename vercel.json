{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.phantomrank.com"
                }
            ],
            "destination": "https://phantomrank.com/$1",
            "statusCode": 301
        }
    ]
}