---
import { siteConfig } from "../../config/site";
import type { FAQ } from "../../types/types";

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  type:
    | "WebSite"
    | "Organization"
    | "SoftwareApplication"
    | "FAQPage"
    | "Article"
    | "BreadcrumbList";
  data?: {
    faqs?: FAQ[];
    breadcrumbs?: BreadcrumbItem[];
    article?: {
      title: string;
      description?: string;
      datePublished?: string;
      dateModified?: string;
      authorName?: string;
      publisherName?: string;
      publisherLogo?: string;
      image?: string;
    };
  };
}

const { type, data = {} } = Astro.props;

let schema = {};

if (type === "WebSite") {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
  };
} else if (type === "Organization") {
  schema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    logo: new URL("/favicon.svg", siteConfig.url).toString(),
    description: siteConfig.description,
    sameAs: Object.values(siteConfig.socialLinks),
  };
} else if (type === "SoftwareApplication") {
  schema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.name,
    description: siteConfig.description,
    url: siteConfig.url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "INR",
      lowPrice: "0",
      highPrice: "30000",
      offerCount: "4",
    },
  };
} else if (type === "Article" && data.article) {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.article.title,
    description: data.article.description || siteConfig.description,
    image: data.article.image || new URL(siteConfig.ogImage, siteConfig.url).toString(),
    datePublished: data.article.datePublished || new Date("2026-06-30").toISOString(),
    dateModified: data.article.dateModified || new Date().toISOString(),
    author: {
      "@type": "Person",
      name: data.article.authorName || siteConfig.author,
    },
    publisher: {
      "@type": "Organization",
      name: data.article.publisherName || siteConfig.name,
      logo: {
        "@type": "ImageObject",
        url: data.article.publisherLogo || new URL("/favicon.svg", siteConfig.url).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": Astro.url.href,
    },
  };
} else if (type === "FAQPage" && data.faqs?.length) {
  schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
} else if (type === "BreadcrumbList" && data.breadcrumbs?.length) {
  schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: data.breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, siteConfig.url).toString(),
    })),
  };
}
---

{Object.keys(schema).length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
