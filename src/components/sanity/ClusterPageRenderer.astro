---
// src/components/sanity/ClusterPageRenderer.astro
// Shared Renderer for Cluster Landing Pages (/learn/[cluster]/)
import ClusterLayout from "../../layouts/ClusterLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  clusterSlug: string;
}

const { clusterSlug } = Astro.props;

const allMdx = await getCollection("learn", (entry) => !entry.data.draft);

const clusterEntry = allMdx.find(
  (entry) =>
    entry.data.pageType === "cluster" &&
    (entry.data.clusterSlug === clusterSlug || entry.slug.includes(clusterSlug))
);

const clusterArticles = allMdx.filter(
  (entry) => entry.data.pageType === "article" && entry.data.cluster === clusterSlug
);

const title = clusterEntry?.data?.title || clusterSlug.charAt(0).toUpperCase() + clusterSlug.slice(1);
const description = clusterEntry?.data?.description || clusterEntry?.data?.seo?.description || `Practical guides, methodology, and frameworks for ${title} in AI search.`;

const { Content } = clusterEntry ? await clusterEntry.render() : { Content: null };

const defaultClusters = [
  { slug: "foundations", title: "Foundations" },
  { slug: "measurement", title: "Measurement" },
  { slug: "diagnosis", title: "Diagnosis" },
  { slug: "optimisation", title: "Optimisation" },
  { slug: "operations", title: "Operations" },
  { slug: "evidence", title: "Evidence" },
];

const formattedSiblings = defaultClusters.map((s) => ({
  slug: s.slug,
  title: s.title,
  href: `/learn/${s.slug}`,
}));

const formattedArticles = clusterArticles.map((a) => {
  const articleSlug = a.slug.split("/").pop() || a.slug;
  return {
    slug: articleSlug,
    title: a.data.title,
    description: a.data.excerpt || a.data.description || "",
    href: `/learn/${clusterSlug}/${articleSlug}`,
    publisheddate: a.data.publishedDate || "",
  };
});
---

<ClusterLayout
  title={`${title} — Topic Cluster | PhantomRank`}
  description={description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
    { name: title },
  ]}
  hubTitle="Learn Hub"
  hubSlug="learn"
  clusters={formattedSiblings}
  currentCluster={clusterSlug}
  articles={formattedArticles}
>
  {Content ? (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <Content />
    </div>
  ) : (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  )}

  {formattedArticles.length > 0 ? (
    <div class="mt-12 border-t border-border pt-10">
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Articles in {title}
      </h2>
      <div class="mt-6 grid gap-4">
        {formattedArticles.map((article) => (
          <a
            href={article.href}
            class="group flex flex-col rounded-lg border border-border bg-card p-5 transition-all hover:border-primary/40 hover:shadow-sm"
          >
            <h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors">
              {article.title}
            </h3>
            {article.description && (
              <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">
                {article.description}
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="mt-12 rounded-xl border border-dashed border-border p-8 text-center text-muted-foreground">
      <p>Articles for <strong>{title}</strong> are currently in editorial review. Check back soon for deep-dive frameworks and research pieces.</p>
      <div class="mt-4 flex justify-center gap-4 text-xs font-semibold text-primary">
        <a href="/learn/ai-seo/" class="hover:underline">Explore AI SEO →</a>
        <a href="/learn/ai-visibility/" class="hover:underline">Explore AI Visibility →</a>
      </div>
    </div>
  )}
</ClusterLayout>
