---
// src/components/sanity/MajorTopicPageRenderer.astro
// Shared Renderer for Major Topic / Pillar Pages (/learn/ai-seo/ & /learn/ai-visibility/)
import PillarLayout from "../../layouts/PillarLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  topicSlug: string;
}

const { topicSlug } = Astro.props;

const allMdx = await getCollection("learn", (entry) => !entry.data.draft);

// Fetch pillar MDX entry from content collection
const pillarEntry = allMdx.find(
  (entry) =>
    entry.data.pageType === "pillar" &&
    (entry.data.slug === topicSlug || entry.slug.includes(topicSlug))
);

// Articles tagged with this topic
const topicArticles = allMdx.filter(
  (entry) =>
    entry.data.pageType === "article" &&
    Array.isArray(entry.data.topics) &&
    entry.data.topics.includes(topicSlug)
);

const title = pillarEntry?.data?.title || (topicSlug === "ai-seo" ? "AI SEO" : "AI Visibility");
const description = pillarEntry?.data?.description || pillarEntry?.data?.seo?.description || `Guide and resources for ${title}.`;
const seoTitle = pillarEntry?.data?.seo?.title || `${title}: Major Topic Guide | PhantomRank`;
const seoDescription = pillarEntry?.data?.seo?.description || description;

const defaultClusters = [
  { slug: "foundations", title: "Foundations" },
  { slug: "measurement", title: "Measurement" },
  { slug: "diagnosis", title: "Diagnosis" },
  { slug: "optimisation", title: "Optimisation" },
  { slug: "operations", title: "Operations" },
  { slug: "evidence", title: "Evidence" },
];

const formattedClusters = defaultClusters.map((c) => ({
  slug: c.slug,
  title: c.title,
  href: `/learn/${c.slug}`,
  description: `Guide and frameworks for ${c.title}`,
  articleCount: allMdx.filter((entry) => entry.data.cluster === c.slug).length,
}));

const formattedArticles = topicArticles.map((a) => {
  const clusterSlug = a.data.cluster || "foundations";
  const articleSlug = a.slug.split("/").pop() || a.slug;
  return {
    title: a.data.title,
    description: a.data.excerpt || a.data.description || "",
    href: `/learn/${clusterSlug}/${articleSlug}`,
    clusterTitle: clusterSlug.charAt(0).toUpperCase() + clusterSlug.slice(1),
    clusterSlug,
    publisheddate: a.data.publishedDate || "",
  };
});

const { Content } = pillarEntry ? await pillarEntry.render() : { Content: null };
---

<PillarLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
    { name: title },
  ]}
  hubTitle={title}
  hubSlug={topicSlug}
  hubDescription={description}
  clusters={formattedClusters}
  totalArticleCount={formattedArticles.length}
  recentArticles={formattedArticles}
>
  {Content ? (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <Content />
    </div>
  ) : (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  )}
</PillarLayout>
