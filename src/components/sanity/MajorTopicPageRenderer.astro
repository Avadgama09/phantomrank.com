---
// src/components/sanity/MajorTopicPageRenderer.astro
// Shared Renderer for Major Topic / Pillar Pages (/learn/ai-seo/ & /learn/ai-visibility/)
import PillarLayout from "../../layouts/PillarLayout.astro";
import PortableText from "./PortableText.astro";
import { sanityFetch } from "../../sanity/lib/client";
import { MAJOR_TOPIC_BY_SLUG_QUERY, ALL_CLUSTERS_QUERY, ARTICLES_IN_MAJOR_TOPIC_QUERY } from "../../sanity/lib/queries";

interface Props {
  topicSlug: string;
}

const { topicSlug } = Astro.props;

const topic = await sanityFetch<any>({
  query: MAJOR_TOPIC_BY_SLUG_QUERY,
  params: { slug: topicSlug },
});

const clusters = await sanityFetch<any[]>({
  query: ALL_CLUSTERS_QUERY,
});

const topicArticles = topic?._id
  ? await sanityFetch<any[]>({
      query: ARTICLES_IN_MAJOR_TOPIC_QUERY,
      params: { topicId: topic._id },
    })
  : [];

const title = topic?.title || topicSlug.toUpperCase();
const description = topic?.shortDescription || `Guide and resources for ${title}.`;
const icon = topic?.icon || "🤖";

const formattedClusters = (clusters || []).map((c) => ({
  slug: c.slug,
  title: c.title,
  href: `/learn/${c.slug}`,
  description: c.shortDescription,
  articleCount: c.articleCount || 0,
}));

const formattedArticles = (topicArticles || []).map((a) => ({
  title: a.title,
  description: a.excerpt || "",
  href: `/learn/${a.primaryCluster?.slug || "foundations"}/${a.slug}`,
  clusterTitle: a.primaryCluster?.title || "Foundations",
  clusterSlug: a.primaryCluster?.slug || "foundations",
  publisheddate: a.publishedAt || "",
}));
---

<PillarLayout
  title={topic?.seo?.title || `${title}: Major Topic Guide | PhantomRank`}
  description={topic?.seo?.description || description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
    { name: title },
  ]}
  hubTitle={title}
  hubSlug={topicSlug}
  hubIcon={icon}
  hubDescription={description}
  clusters={formattedClusters}
  totalArticleCount={formattedArticles.length}
  recentArticles={formattedArticles}
>
  {topic?.introduction ? (
    <PortableText value={topic.introduction} />
  ) : (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  )}
</PillarLayout>
