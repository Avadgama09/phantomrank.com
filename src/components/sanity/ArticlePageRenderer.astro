---
// src/components/sanity/ArticlePageRenderer.astro
// Shared Renderer for Article & Research Study pages (/learn/[cluster]/[article])
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  clusterSlug: string;
  articleSlug: string;
}

const { clusterSlug, articleSlug } = Astro.props;

const allMdx = await getCollection("learn", (entry) => !entry.data.draft);

// Find matching article MDX entry
const articleEntry = allMdx.find(
  (entry) =>
    entry.slug === articleSlug ||
    entry.slug === `${clusterSlug}/${articleSlug}` ||
    entry.slug.endsWith(`/${articleSlug}`)
);

const clusterArticles = allMdx.filter(
  (entry) => entry.data.pageType === "article" && entry.data.cluster === clusterSlug
);

const siblingArticles = clusterArticles.map((a) => {
  const slug = a.slug.split("/").pop() || a.slug;
  return {
    slug,
    title: a.data.title,
    href: `/learn/${clusterSlug}/${slug}`,
  };
});

const title = articleEntry?.data?.title || "Article";
const description = articleEntry?.data?.excerpt || articleEntry?.data?.description || "";
const seoTitle = articleEntry?.data?.seo?.title || `${title} | PhantomRank`;
const seoDescription = articleEntry?.data?.seo?.description || description;
const clusterTitle = clusterSlug.charAt(0).toUpperCase() + clusterSlug.slice(1);

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Learn", href: "/learn" },
  { name: clusterTitle, href: `/learn/${clusterSlug}` },
  { name: title },
];

const { Content } = articleEntry ? await articleEntry.render() : { Content: null };
---

<ArticleLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={breadcrumbs}
  hubTitle="AI SEO"
  hubSlug="ai-seo"
  clusterTitle={clusterTitle}
  clusterSlug={clusterSlug}
  siblingArticles={siblingArticles}
  currentArticle={articleSlug}
  totalArticles={siblingArticles.length}
  datePublished={articleEntry?.data?.publishedDate}
  dateModified={articleEntry?.data?.dateModified || articleEntry?.data?.updatedDate || articleEntry?.data?.publishedDate}
  author={articleEntry?.data?.author || "Ashish Vadgama"}
  featuredImage={articleEntry?.data?.featuredImage?.src}
>
  <!-- Answer Summary Box (Rendered Visibly Beneath H1) -->
  {articleEntry?.data?.answerSummary && (
    <div class="my-6 rounded-2xl border border-primary/30 bg-primary/5 p-6 shadow-sm">
      <h4 class="text-xs font-bold uppercase tracking-widest text-primary mb-2">
        Answer Summary
      </h4>
      <p class="text-base font-medium leading-relaxed text-foreground">
        {articleEntry.data.answerSummary}
      </p>
    </div>
  )}

  <!-- MDX Article Body -->
  {Content ? (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <Content />
    </div>
  ) : (
    <p class="text-muted-foreground">Article content is under editorial review.</p>
  )}
</ArticleLayout>
