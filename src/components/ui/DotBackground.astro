---
interface Props {
  containerId?: string;
}
const { containerId = "hero-section" } = Astro.props;
---

<canvas
  id="dot-distortion-canvas"
  class="absolute inset-0 z-0 pointer-events-none opacity-40 dark:opacity-60 mix-blend-screen"
  data-container={containerId}
></canvas>
<div
  class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,var(--background)_100%)] z-0 pointer-events-none"
>
</div>

<script>
  // --- Dot Distortion Canvas Effect ---
  const initCanvas = () => {
    const canvas = document.getElementById(
      "dot-distortion-canvas",
    ) as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const containerId = canvas.getAttribute("data-container") || "hero-section";
    const section = document.getElementById(containerId);
    if (!section) return;

    let width = 0;
    let height = 0;
    let dots: { baseX: number; baseY: number; x: number; y: number }[] = [];

    // Configuration
    const spacing = 22; // Space between dots
    const radius = 1.2; // Size of dots
    const mouseRadius = 150; // How far the mouse repels
    const repelForce = 35; // How strongly dots are pushed

    let mouse = { x: -1000, y: -1000 };
    let animationFrameId: number;

    const createDots = () => {
      dots = [];
      let currentSpacing = spacing;
      
      const isMobile = window.innerWidth < 768;
      if (isMobile) {
        currentSpacing = spacing * 1.5;
      }

      // Calculate spacing dynamically to ensure max ~2000 dots for performance
      // If a screen is extremely large (e.g., 4k), a fixed spacing of 22 causes >17,000 dots,
      // which can freeze the main thread completely on load.
      const targetMaxDots = 2000;
      const area = width * height;
      if (area > 0 && area / (currentSpacing * currentSpacing) > targetMaxDots) {
        currentSpacing = Math.sqrt(area / targetMaxDots);
      }

      const rows = Math.ceil(height / currentSpacing) + 1;
      const cols = Math.ceil(width / currentSpacing) + 1;

      const offsetX = (width - (cols - 1) * currentSpacing) / 2;
      const offsetY = (height - (rows - 1) * currentSpacing) / 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = offsetX + c * currentSpacing;
          const y = offsetY + r * currentSpacing;
          dots.push({ baseX: x, baseY: y, x, y });
        }
      }
    };

    const resize = () => {
      // Cap DPR to 2 to prevent excessive memory/GPU usage on high-density mobile screens
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = section.clientWidth;
      height = section.clientHeight;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);
      createDots();
    };

    const handleMouseMove = (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    };

    const handleMouseLeave = () => {
      mouse.x = -1000;
      mouse.y = -1000;
    };

    let isVisible = true;
    let isAnimating = false;

    const startAnimation = () => {
      if (!isAnimating && isVisible && !document.hidden) {
        isAnimating = true;
        animate();
      }
    };

    const stopAnimation = () => {
      if (isAnimating) {
        isAnimating = false;
        cancelAnimationFrame(animationFrameId);
      }
    };

    const animate = () => {
      if (!isAnimating) return;

      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgba(59, 130, 246, 0.7)";

      const time = performance.now() * 0.001;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];

        const dx = mouse.x - dot.baseX;
        const dy = mouse.y - dot.baseY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        let targetX = dot.baseX;
        let targetY = dot.baseY;

        // Ambient wave movement (noise simulation)
        targetX += Math.sin(time + dot.baseX * 0.01) * 2;
        targetY += Math.cos(time + dot.baseY * 0.01) * 2;

        // Mouse repulsion
        if (dist < mouseRadius) {
          const force = (mouseRadius - dist) / mouseRadius;
          const angle = Math.atan2(dy, dx);
          targetX -= Math.cos(angle) * force * repelForce;
          targetY -= Math.sin(angle) * force * repelForce;
        }

        // Spring physics
        dot.x += (targetX - dot.x) * 0.15;
        dot.y += (targetY - dot.y) * 0.15;

        // Draw dot
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(animate);
    };

    // IntersectionObserver to pause canvas animation when scrolled offscreen
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            startAnimation();
          } else {
            stopAnimation();
          }
        });
      },
      { threshold: 0.05 },
    );

    observer.observe(section);

    const handleVisibilityChange = () => {
      if (document.hidden) {
        stopAnimation();
      } else if (isVisible) {
        startAnimation();
      }
    };

    window.addEventListener("resize", resize);
    section.addEventListener("mousemove", handleMouseMove);
    section.addEventListener("mouseleave", handleMouseLeave);
    document.addEventListener("visibilitychange", handleVisibilityChange);

    resize();
    startAnimation();

    return () => {
      observer.disconnect();
      window.removeEventListener("resize", resize);
      section.removeEventListener("mousemove", handleMouseMove);
      section.removeEventListener("mouseleave", handleMouseLeave);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
      stopAnimation();
    };
  };

  // Initialize canvas on load and during view transitions
  let cleanupCanvas: (() => void) | undefined;

  const setup = () => {
    if (cleanupCanvas) cleanupCanvas();
    cleanupCanvas = initCanvas();
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
