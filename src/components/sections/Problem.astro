---
---

<section id="scene-invisible" class="relative bg-background border-t border-border">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="invisible-container flex flex-col md:flex-row py-12 md:py-16">
      
      <!-- Left Column: Pinned Statement -->
      <div class="md:w-1/2 md:pr-16 flex flex-col justify-center">
        <div class="pinned-statement">
          <h2 class="text-4xl md:text-6xl font-medium tracking-tight text-foreground leading-tight mb-6">
            If AI can’t see you, buyers won’t
          </h2>
          <p class="text-xl text-muted-foreground font-light">
            PhantomRank shows how AI answers talk about you and your competitors, at both brand and industry level.
          </p>
        </div>
      </div>

      <!-- Right Column: Scroll-triggered reveals -->
      <div class="md:w-1/2 mt-16 md:mt-0 flex flex-col justify-center gap-12 py-8">
        
        <div class="reveal-text">
          <div class="w-12 h-[1px] bg-foreground mb-6"></div>
          <h3 class="text-2xl font-medium text-foreground mb-4">Brand-level AI visibility tracker</h3>
          <p class="text-muted-foreground text-lg font-light leading-relaxed mb-6">
            Monitor one brand across ChatGPT, Gemini, Perplexity, Grok, NVIDIA and more, including how often AI chooses competitors instead.
          </p>
          <ul class="space-y-3 text-muted-foreground/90 font-light">
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Compare your mentions and descriptions to competitor brands in real AI answers.</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Catch cases where AI engines crawl your pages but cite someone else instead.</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Track semantic resonance so you know whether AI understands your positioning or mislabels you.</span>
            </li>
          </ul>
        </div>

        <div class="reveal-text">
          <div class="w-12 h-[1px] bg-foreground mb-6"></div>
          <h3 class="text-2xl font-medium text-foreground mb-4">Industry-level visibility & competitor analysis</h3>
          <p class="text-muted-foreground text-lg font-light leading-relaxed mb-6">
            Audit your whole category to see which brands AI engines consistently recommend, ignore, or warn against.
          </p>
          <ul class="space-y-3 text-muted-foreground/90 font-light">
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Map the AI-era leaderboard: Leaders, Challengers, Niche players.</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Find information gaps where no one is serving good data and your content can become the default source.</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-primary mt-1">•</span>
              <span>Analyse sentiment and placement to understand how AI frames each competitor’s strengths and weaknesses.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Pin the left statement while the right side scrolls
  ScrollTrigger.matchMedia({
    // Desktop only for pinning
    "(min-width: 768px)": function() {
      gsap.to(".pinned-statement", {
        scrollTrigger: {
          trigger: ".invisible-container",
          start: "center center",
          end: "bottom bottom",
          pin: ".pinned-statement",
          pinSpacing: false,
        }
      });
    }
  });

  // Reveal text blocks sequentially as they enter the viewport
  gsap.utils.toArray(".reveal-text").forEach((text: any) => {
    gsap.fromTo(text, 
      { opacity: 0.2, y: 50 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1, 
        ease: "power2.out",
        scrollTrigger: {
          trigger: text,
          start: "top 80%",
          end: "top 50%",
          scrub: 1,
        }
      }
    );
  });
</script>
