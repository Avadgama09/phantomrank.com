---
---

<section id="scene-invisible" class="relative bg-background border-t border-border">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="invisible-container flex flex-col md:flex-row min-h-screen py-24 md:py-32">
      
      <!-- Left Column: Pinned Statement -->
      <div class="md:w-1/2 md:pr-16 flex flex-col justify-center">
        <div class="pinned-statement">
          <h2 class="text-4xl md:text-6xl font-medium tracking-tight text-foreground leading-tight">
            Brands don't know how AI sees them
          </h2>
          <p class="mt-6 text-xl text-muted-foreground font-light max-w-md">
            Hundreds of millions of people now get answers from AI assistants before they click a single link. If your brand isn’t mentioned in those answers, you barely exist in the research journey.
          </p>
        </div>
      </div>

      <!-- Right Column: Scroll-triggered reveals -->
      <div class="md:w-1/2 mt-16 md:mt-0 flex flex-col justify-center gap-24 py-[30vh]">
        
        <div class="reveal-text">
          <div class="w-12 h-[1px] bg-foreground mb-6"></div>
          <h3 class="text-2xl font-medium text-foreground mb-4">Google rankings don't predict AI recommendations</h3>
          <p class="text-muted-foreground text-lg font-light leading-relaxed">
            You can rank #1 in Google and still be invisible in ChatGPT or Perplexity. AI assistants pull from different sources, weigh content differently, and often ignore traditional SEO signals when choosing which brands to mention.
          </p>
        </div>

        <div class="reveal-text">
          <div class="w-12 h-[1px] bg-foreground mb-6"></div>
          <h3 class="text-2xl font-medium text-foreground mb-4">Competitors are stealing invisible share of voice</h3>
          <p class="text-muted-foreground text-lg font-light leading-relaxed">
            Every AI-generated answer is a shortlist. If your brand doesn’t appear, a competitor does. AI share of voice gaps widen quietly over time and become harder to close the longer you ignore them.
          </p>
        </div>

        <div class="reveal-text">
          <div class="w-12 h-[1px] bg-foreground mb-6"></div>
          <h3 class="text-2xl font-medium text-foreground mb-4">You're guessing at AI strategy without search intelligence</h3>
          <p class="text-muted-foreground text-lg font-light leading-relaxed">
            Most teams are making AI-era SEO and content decisions in the dark. Without search intelligence on where you’re cited, skipped, or misrepresented, every AI SEO, GEO, or AEO experiment is just guesswork.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Pin the left statement while the right side scrolls
  ScrollTrigger.matchMedia({
    // Desktop only for pinning
    "(min-width: 768px)": function() {
      gsap.to(".pinned-statement", {
        scrollTrigger: {
          trigger: ".invisible-container",
          start: "center center",
          end: "bottom bottom",
          pin: ".pinned-statement",
          pinSpacing: false,
        }
      });
    }
  });

  // Reveal text blocks sequentially as they enter the viewport
  gsap.utils.toArray(".reveal-text").forEach((text: any) => {
    gsap.fromTo(text, 
      { opacity: 0.2, y: 50 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1, 
        ease: "power2.out",
        scrollTrigger: {
          trigger: text,
          start: "top 80%",
          end: "top 50%",
          scrub: 1,
        }
      }
    );
  });
</script>
