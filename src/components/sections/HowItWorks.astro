---
---

<section id="scene-stack" class="relative bg-background border-t border-border py-24 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-24 stack-header">
      <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-foreground mb-6">
        The paradigm has shifted
      </h2>
      <p class="text-xl text-muted-foreground font-light max-w-2xl mx-auto">
        Search is no longer just about Google, SEO, and your website. The AI Search Stack relies on retrieval, reasoning, citation, and recommendation.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-8 max-w-5xl mx-auto">
      
      <!-- Legacy Stack -->
      <div class="flex flex-col items-center">
        <div class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-12">Legacy Search</div>
        
        <div class="stack-item-legacy flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">Google</div>
          <div class="w-px h-12 bg-border my-4"></div>
        </div>
        
        <div class="stack-item-legacy flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">SEO</div>
          <div class="w-px h-12 bg-border my-4"></div>
        </div>
        
        <div class="stack-item-legacy flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">Website</div>
        </div>
      </div>

      <!-- Divider for mobile -->
      <div class="w-full h-px bg-border md:hidden"></div>

      <!-- AI Stack -->
      <div class="flex flex-col items-center">
        <div class="text-sm font-medium text-primary uppercase tracking-widest mb-12">The AI Stack</div>
        
        <div class="stack-item-ai flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">Retrieval</div>
          <div class="w-px h-12 bg-primary/30 my-4"></div>
        </div>
        
        <div class="stack-item-ai flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">Reasoning</div>
          <div class="w-px h-12 bg-primary/30 my-4"></div>
        </div>
        
        <div class="stack-item-ai flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-medium text-foreground">Citation</div>
          <div class="w-px h-12 bg-primary/30 my-4"></div>
        </div>
        
        <div class="stack-item-ai flex flex-col items-center opacity-0 transform translate-y-8">
          <div class="text-xl font-bold text-foreground">Recommendation</div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#scene-stack",
      start: "top 60%",
      end: "center center",
      scrub: false,
    }
  });

  tl.fromTo(".stack-header", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1, ease: "power2.out" })
    .to(".stack-item-legacy", { opacity: 1, y: 0, duration: 0.8, stagger: 0.2, ease: "power2.out" })
    .to(".stack-item-ai", { opacity: 1, y: 0, duration: 0.8, stagger: 0.2, ease: "power2.out" }, "-=0.4");
</script>
