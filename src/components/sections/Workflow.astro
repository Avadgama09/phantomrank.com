<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Fill the central line based on scroll
  gsap.to(".workflow-progress", {
    height: "100%",
    ease: "none",
    scrollTrigger: {
      trigger: ".workflow-container",
      start: "top center",
      end: "bottom center",
      scrub: true,
    }
  });

  // Reveal each node as it comes into view
  const nodes = gsap.utils.toArray(".workflow-node");
  nodes.forEach((node: any) => {
    const text = node.querySelector(".node-text");
    const mobileText = node.querySelector(".node-text-mobile");
    const circle = node.querySelector(".node-circle");
    const dot = node.querySelector(".node-dot");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: node,
        start: "top 60%",
        toggleActions: "play none none reverse",
      }
    });

    tl.to(circle, { borderColor: "var(--foreground)", duration: 0.3 })
      .to(dot, { backgroundColor: "var(--foreground)", duration: 0.3 }, "<")
      .to(text, { opacity: 1, x: 0, duration: 0.5, ease: "power2.out" }, "<");
      
    if (mobileText) {
      tl.to(mobileText, { opacity: 1, x: 0, duration: 0.5, ease: "power2.out" }, "<");
    }
  });
</script>
