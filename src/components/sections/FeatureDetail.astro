---
import type { Feature } from "../../types/types";

interface Props {
  feature: Feature;
  insight: string;
  outputs: string[];
  howItWorks: string[];
  useCases: { scenario: string; outcome: string }[];
  includes: string[];
}

const { feature, insight, outputs, howItWorks, useCases, includes } = Astro.props;
const isLive = feature.status === "live";
---

<article class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
  
  {/* ── Top Hero Section (2 Columns) ── */}
  <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
    <div class="reveal">
      {!isLive && (
        <div class="inline-flex mb-6 rounded-xl border border-amber-500/20 bg-amber-500/5 p-2 px-4 text-sm text-amber-400 font-medium">
          In development. Join the waitlist.
        </div>
      )}
      
      <div class="flex items-center gap-3 mb-4">
        <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${isLive ? "bg-green-500/10 text-green-400" : "bg-amber-500/10 text-amber-400"}`}>
          {isLive ? "Live" : "Coming Soon"}
        </span>
        <span class="text-sm text-muted-foreground">{feature.category}</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground mb-6">
        {feature.name}
      </h1>
      <p class="text-xl text-muted-foreground mb-8">
        {feature.oneLiner}
      </p>

      {/* The Insight moved into the Hero */}
      <div class="bg-card/50 rounded-2xl border border-white/5 p-6 backdrop-blur-sm">
        <p class="text-muted-foreground leading-relaxed">{insight}</p>
      </div>
    </div>

    {/* HERO IMAGE SLOT */}
    <div class="reveal relative">
       <!-- Soft Glow Behind Image -->
       <div class="absolute inset-0 bg-primary/20 blur-[100px] rounded-full pointer-events-none z-0"></div>
       <div class="relative z-10 rounded-2xl border border-white/10 bg-white/5 p-2 backdrop-blur-md shadow-2xl shadow-black/50">
          <slot name="hero-image" />
       </div>
    </div>
  </div>

  {/* ── Workflow Section (2 Columns reversed) ── */}
  <section class="reveal mb-24 grid lg:grid-cols-2 gap-16 items-center">
    {/* WORKFLOW IMAGE SLOT */}
    <div class="order-2 lg:order-1 relative">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-2 backdrop-blur-md shadow-2xl shadow-black/50">
         <slot name="workflow-image" />
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <h2 class="text-3xl font-bold text-foreground mb-8">Clarity, step by step</h2>
      <ul class="space-y-6">
        {howItWorks.map((step, index) => (
          <li class="flex items-start gap-4 p-4 rounded-xl hover:bg-white/5 transition-colors border border-transparent hover:border-white/10">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary mt-1">
              {index + 1}
            </span>
            <p class="text-muted-foreground text-lg leading-relaxed">{step}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── The Rest of your Content (Grid Layouts) ── */}
  <div class="grid lg:grid-cols-2 gap-12 mb-24">
    <section class="reveal">
      <h2 class="text-2xl font-bold text-foreground mb-6">What you'll see</h2>
      <div class="bg-card rounded-2xl border border-border p-8 h-full">
        <ul class="space-y-4">
          {outputs.map((output) => (
            <li class="flex items-start gap-3">
              <span class="text-primary mt-1">✦</span>
              <span class="text-muted-foreground">{output}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="reveal">
      <h2 class="text-2xl font-bold text-foreground mb-6">What's included</h2>
      <div class="bg-card rounded-2xl border border-border p-8 h-full">
        <ul class="space-y-4">
          {includes.map((item) => (
            <li class="flex items-start gap-3">
              <span class="text-green-400 mt-1">✓</span>
              <span class="text-muted-foreground">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  {/* ── Use Cases Grid ── */}
  <section class="reveal mb-24">
    <h2 class="text-3xl font-bold text-foreground mb-8 text-center">Built for Agency Workflows</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {useCases.map((uc) => (
        <div class="bg-card hover:bg-white/5 transition-all rounded-2xl border border-border hover:border-primary/30 p-6 shadow-lg">
          <p class="text-lg font-semibold text-foreground mb-3">{uc.scenario}</p>
          <p class="text-sm text-muted-foreground leading-relaxed">{uc.outcome}</p>
        </div>
      ))}
    </div>
  </section>

  <slot /> {/* For the CTA */}
</article>