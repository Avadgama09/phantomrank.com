---
const brandPlans = [
  {
    name: "Free Starter Plan",
    price: "₹0",
    period: "Pay As You Go",
    description:
      "The perfect way to dip your toes into AI visibility tracking.",
    seats: "1 User Seat",
    features: ["Standard email support. Top-up credits anytime."],
    limits: [
      "No custom prompt editing, no web search.",
      "Industry Metrics, GSO, and Community Manager features not included.",
    ],
    modelsTitle: "Included AI Models (Fast & Lightweight):",
    models: [
      "Perplexity Sonar",
      "OpenAI GPT-5.4 Nano",
      "OpenAI GPT-5 Mini",
      "Google Gemini 3.1 Flash Lite (Standard & Preview)",
    ],
    cta: { text: "Start Free", href: "/signup?plan=free-starter", variant: "secondary" },
  },
  {
    name: "Growth Plan",
    price: "₹7,999",
    period: "month",
    description: "Unrestricted AI analysis with flagship reasoning models.",
    seats: "1 User Seat",
    scope: "Unlimited Intents, 45 Prompts per run",
    isPopular: true,
    features: [
      "Includes Project Creation, Prompt Editing, team collaboration and model controls.",
    ],
    modelsTitle: "Included AI Models (Flagship & Premium):",
    models: [
      "Everything in Starter, plus:",
      "NVIDIA Nemotron-3 Super (120B)",
      "xAI Grok (4.3, 4.20 Reasoning, 4.20 Non-Reasoning, 4.20 Multi-Agent)",
      "Google Gemini (3 Flash Preview, 3.5 Flash)",
      "Anthropic Claude Haiku 4.5",
      "Perplexity (Kimi K2.7 Code, GLM 5.2)",
      "OpenAI GPT-5 Family (GPT-5, 5.1)",
      "Google Gemini 3.1 Pro Preview",
    ],
    cta: { text: "Choose Growth Plan", href: "/signup?plan=growth", variant: "primary" },
  },
  {
    name: "Freelance Plan",
    price: "₹14,999",
    period: "month",
    description:
      "Maximum horsepower with full access to all flagship reasoning models.",
    seats: "1 User Seat",
    scope: "Unlimited Intents, 45 Prompts per run (Credits worth 14,999/m)",
    features: [
      "Includes Project Creation, Prompt Editing, team collaboration and model controls.",
    ],
    modelsTitle: "Included AI Models:",
    models: [
      "Full unrestricted access to all 28+ supported models across OpenAI, Anthropic, Google, Perplexity, xAI, and NVIDIA."
    ],
    cta: { text: "Choose Freelance", href: "/signup?plan=freelance", variant: "primary" },
  },
];

const agencyPlans = [
  {
    name: "Authority Plan",
    price: "₹30,000",
    period: "month",
    description: "Built for boutique agencies managing multiple client brands.",
    seats: "3 User Seats",
    scope: "Up to 45 Prompts per run",
    isPopular: true,
    features: ["Deep analysis limits, Prompt Editing, and team collaboration"],
    modelsTitle: "Included AI Models:",
    models: [
      "Full access to the entire arsenal of all 28+ supported models across OpenAI, Anthropic, Google, Perplexity, xAI, and NVIDIA.",
    ],
    cta: { text: "Get Access", href: "/signup?plan=authority", variant: "primary" },
  },
  {
    name: "Enterprise Plan",
    price: "Custom",
    period: "tailored",
    description: "Scale your agency operations with maximum throughput.",
    seats: "Customisable",
    scope: "Customisable",
    features: [
      "Highest capacity prompt limits per run, Prompt Editing, and premium support limits, all available model controls.",
    ],
    modelsTitle: "Included AI Models:",
    models: ["Full unrestricted access to all 28+ supported models."],
    cta: { text: "Contact Sales", href: "/signup?plan=enterprise", variant: "secondary" },
  },
];

interface Props {
  variant?: "preview" | "full";
}

const { variant = "preview" } = Astro.props;
const isPreview = variant === "preview";
---

<section class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
  <div class="text-center mb-16">
    <div
      class="reveal inline-flex items-center gap-2 px-3 py-1 text-primary text-lg font-semibold"
    >
      Pricing
    </div>
    <h2
      class="reveal text-3xl md:text-4xl font-bold tracking-tight text-foreground mb-4"
    >
      {isPreview ? "Simple, transparent pricing" : "Plans for every scale"}
    </h2>
    <p class="reveal text-xl text-muted-foreground max-w-2xl mx-auto">
      {
        isPreview
          ? "Choose a plan that fits your needs. Pay as you go or scale with dedicated limits."
          : "Access search intelligence across all major AI engines. Built for brands and marketing agencies."
      }
    </p>
  </div>

  <div
    class="tabs tabs-boxed bg-card/50 border border-border/50 p-1.5 rounded-2xl mx-auto w-fit mb-12 flex gap-2 backdrop-blur-sm"
  >
    <!-- Brands Tab -->
    <input
      type="radio"
      name="pricing_tabs"
      class="tab h-10 px-6 rounded-xl text-sm font-medium transition-all checked:bg-primary checked:text-white cursor-pointer"
      aria-label="For Brands"
      checked="checked"
    />
    <div class="tab-content w-full mt-12">
      <div class="grid gap-6 grid-cols-1 lg:grid-cols-3 max-w-7xl mx-auto">
        {
          brandPlans.map((plan) => (
            <div
              class:list={[
                "reveal relative flex flex-col rounded-2xl border p-8 shadow-sm transition-all",
                plan.isPopular
                  ? "border-primary bg-card ring-2 ring-primary/20"
                  : "border-border bg-card hover:border-primary/50",
              ]}
            >
              {plan.isPopular && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                  <span class="inline-flex items-center rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white">
                    Most Popular
                  </span>
                </div>
              )}

              <div class="mb-6">
                <h3 class="text-xl font-bold text-foreground">{plan.name}</h3>
                <p class="text-sm text-muted-foreground mt-1 min-h-[40px]">
                  {plan.description}
                </p>
              </div>

              <div class="mb-6 flex items-baseline gap-1">
                <span class="text-4xl font-bold tracking-tight text-foreground">
                  {plan.price}
                </span>
                <span class="text-sm text-muted-foreground">
                  /{plan.period}
                </span>
              </div>

              <div class="mb-4 flex items-center gap-2 text-xs font-semibold text-primary uppercase tracking-wider">
                <span>{plan.seats}</span>
                {plan.scope && (
                  <>
                    <span class="text-muted-foreground/30">•</span>
                    <span class="line-clamp-1">{plan.scope}</span>
                  </>
                )}
              </div>

              <div class="space-y-3 mb-8">
                {plan.features.map((feature) => (
                  <div class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <svg
                      class="h-5 w-5 shrink-0 text-green-500 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span>{feature}</span>
                  </div>
                ))}
                {plan.limits &&
                  plan.limits.map((limit) => (
                    <div class="flex items-start gap-2.5 text-sm text-muted-foreground/60">
                      <svg
                        class="h-5 w-5 shrink-0 text-red-500/50 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 18L18 6M6 6l12 12"
                        />
                      </svg>
                      <span>{limit}</span>
                    </div>
                  ))}
              </div>

              <div class="mt-auto pt-6 border-t border-border/50 mb-8">
                <h4 class="text-xs font-bold uppercase tracking-wider text-foreground/80 mb-3">
                  {plan.modelsTitle}
                </h4>
                <ul class="space-y-1.5">
                  {plan.models.map((model) => {
                    const isHeader =
                      model === "Everything in Starter, plus:" ||
                      model === "Everything in Starter, plus" ||
                      model === "Everything in Growth, plus:" ||
                      model === "Everything in Growth, plus";
                    return (
                      <li
                        class:list={[
                          "text-xs leading-relaxed",
                          isHeader
                            ? "font-semibold text-primary mt-2 mb-1 list-none"
                            : "text-muted-foreground list-disc list-inside ml-1",
                        ]}
                      >
                        {model}
                      </li>
                    );
                  })}
                </ul>
              </div>

              {plan.cta.text === "Get Access" ? (
                <div class="aura aura-silver rounded-full w-full" style="--aura-radius: 9999px;">
                  <a
                    href={plan.cta.href}
                    class="block w-full rounded-full bg-zinc-950 text-zinc-100 border border-zinc-800 py-3 text-center text-sm font-semibold transition-all hover:bg-zinc-900 hover:text-white"
                  >
                    {plan.cta.text}
                  </a>
                </div>
              ) : (
                <a
                  href={plan.cta.href}
                  class:list={[
                    "block w-full rounded-full py-3 text-center text-sm font-semibold transition-all",
                    plan.cta.variant === "primary"
                      ? "bg-primary text-white hover:bg-primary/80 hover:shadow-lg hover:shadow-primary/25"
                      : "bg-foreground/10 text-foreground hover:bg-foreground/20",
                  ]}
                >
                  {plan.cta.text}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Agencies Tab -->
    <input
      type="radio"
      name="pricing_tabs"
      class="tab h-10 px-6 rounded-xl text-sm font-medium transition-all checked:bg-primary checked:text-white cursor-pointer"
      aria-label="For Agencies"
    />
    <div class="tab-content w-full mt-12">
      <div class="grid gap-8 grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto">
        {
          agencyPlans.map((plan) => (
            <div
              class:list={[
                "reveal relative flex flex-col rounded-2xl border p-8 shadow-sm transition-all",
                plan.isPopular
                  ? "border-primary bg-card ring-2 ring-primary/20"
                  : "border-border bg-card hover:border-primary/50",
              ]}
            >
              {plan.isPopular && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                  <span class="inline-flex items-center rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white">
                    Most Popular
                  </span>
                </div>
              )}

              <div class="mb-6">
                <h3 class="text-xl font-bold text-foreground">{plan.name}</h3>
                <p class="text-sm text-muted-foreground mt-1 min-h-[40px]">
                  {plan.description}
                </p>
              </div>

              <div class="mb-6 flex items-baseline gap-1">
                <span class="text-4xl font-bold tracking-tight text-foreground">
                  {plan.price}
                </span>
                <span class="text-sm text-muted-foreground">
                  /{plan.period}
                </span>
              </div>

              <div class="mb-4 flex items-center gap-2 text-xs font-semibold text-primary uppercase tracking-wider">
                <span>{plan.seats}</span>
                {plan.scope && (
                  <>
                    <span class="text-muted-foreground/30">•</span>
                    <span>{plan.scope}</span>
                  </>
                )}
              </div>

              <div class="space-y-3 mb-8">
                {plan.features.map((feature) => (
                  <div class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <svg
                      class="h-5 w-5 shrink-0 text-green-500 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>

              <div class="mt-auto pt-6 border-t border-border/50 mb-8">
                <h4 class="text-xs font-bold uppercase tracking-wider text-foreground/80 mb-3">
                  {plan.modelsTitle}
                </h4>
                <ul class="space-y-1.5">
                  {plan.models.map((model) => (
                    <li class="text-xs leading-relaxed text-muted-foreground list-disc list-inside ml-1">
                      {model}
                    </li>
                  ))}
                </ul>
              </div>

              {plan.cta.text === "Get Access" ? (
                <div class="aura aura-silver rounded-full w-full" style="--aura-radius: 9999px;">
                  <a
                    href={plan.cta.href}
                    class="block w-full rounded-full bg-zinc-950 text-zinc-100 border border-zinc-800 py-3 text-center text-sm font-semibold transition-all hover:bg-zinc-900 hover:text-white"
                  >
                    {plan.cta.text}
                  </a>
                </div>
              ) : (
                <a
                  href={plan.cta.href}
                  class:list={[
                    "block w-full rounded-full py-3 text-center text-sm font-semibold transition-all",
                    plan.cta.variant === "primary"
                      ? "bg-primary text-white hover:bg-primary/80 hover:shadow-lg hover:shadow-primary/25"
                      : "bg-foreground/10 text-foreground hover:bg-foreground/20",
                  ]}
                >
                  {plan.cta.text}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    isPreview && (
      <div class="reveal text-center mt-12">
        <p class="text-muted-foreground mb-4">
          Need custom volume or dedicated integrations? We have Enterprise
          plans.
        </p>
        <a
          href="/pricing"
          class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80"
        >
          View all plans
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </a>
      </div>
    )
  }
</section>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function setup() {
    gsap.utils.toArray(".reveal").forEach((elem: any) => {
      gsap.fromTo(
        elem,
        { autoAlpha: 0, y: 30 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: elem,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        }
      );
    });
  }

  // Run on initial load
  setup();

  // Run on subsequent Astro page navigations
  document.addEventListener("astro:page-load", setup);
</script>
