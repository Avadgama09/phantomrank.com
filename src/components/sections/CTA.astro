---
---

<section id="scene-cta" class="relative bg-background py-32 border-t border-border">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="cta-content opacity-0 transform translate-y-8">
      <h2 class="text-4xl md:text-6xl font-medium tracking-tight text-foreground mb-8 leading-tight">
        Start tracking your <span class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">AI visibility</span> today
      </h2>
      
      <p class="text-xl text-muted-foreground font-light mb-12 max-w-2xl mx-auto">
        PhantomRank shows how AI assistants and search engines talk about your brand.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a
          href="/signup"
          class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors rounded-full"
        >
          Get Access
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-foreground bg-transparent border border-border hover:bg-muted/50 transition-colors rounded-full"
        >
          See Use Cases
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.to(".cta-content", {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: "#scene-cta",
      start: "top 75%",
      toggleActions: "play none none reverse",
    }
  });
</script>
