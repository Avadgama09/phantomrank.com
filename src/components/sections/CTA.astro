---

<section id="scene-cta" class="relative bg-background py-32 border-t border-border">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="cta-content">
      <h2 class="text-4xl md:text-6xl font-medium tracking-tight text-foreground mb-8 leading-tight flex flex-col md:block items-center justify-center">
        <span class="block">Stop guessing what</span>
        <span class="block"><span id="ai-word-cycler" class="inline-block text-center md:text-left bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">ChatGPT</span> says about you.</span>
      </h2>
      
      <p class="text-xl text-muted-foreground font-light mb-12 max-w-2xl mx-auto">
        PhantomRank gives you the diagnostics, competitor benchmarks, and concrete content strategy to build visibility where your next buyers are actually looking.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a
          href="/pricing"
          class="btn-primary"
        >
          Explore Pricing
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const setupCTA = () => {
    gsap.fromTo(".cta-content", 
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#scene-cta",
          start: "top 85%",
          toggleActions: "play none none none",
          once: true,
        }
      }
    );
  };

  setupCTA();
  document.addEventListener("astro:page-load", setupCTA);

  // Word Cycler
  const engines = ["ChatGPT", "Perplexity", "Gemini", "Claude", "Grok", "Moonshot AI", "Nemotron"];
  let currentIndex = 0;
  const cycler = document.getElementById("ai-word-cycler");

  function cycleWord() {
    gsap.to(cycler, {
      opacity: 0,
      y: -15,
      duration: 0.4,
      delay: 2.5,
      ease: "power2.in",
      onComplete: () => {
        currentIndex = (currentIndex + 1) % engines.length;
        if (cycler) {
          cycler.innerText = engines[currentIndex];
        }
        gsap.fromTo(cycler, 
          { opacity: 0, y: 15 }, 
          { opacity: 1, y: 0, duration: 0.4, ease: "power2.out", onComplete: cycleWord }
        );
      }
    });
  }

  if (cycler) {
    gsap.delayedCall(1, cycleWord);
  }
</script>
