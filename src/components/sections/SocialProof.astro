---
---

<section id="scene-evidence" class="relative bg-background border-t border-border py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Factual Reality -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 mb-32 evidence-facts">
      
      <div class="fact-column flex flex-col opacity-0 transform translate-y-8">
        <h4 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-8">Methodology</h4>
        <ul class="space-y-4 text-xl font-medium text-foreground">
          <li>9 Intent Types Tracked</li>
          <li>45 Prompts Per Brand</li>
          <li>3 Live Intelligence Tools</li>
          <li>100% Multi-Client Ready</li>
          <li>Full Buyer Journey Coverage</li>
        </ul>
      </div>

      <div class="fact-column flex flex-col opacity-0 transform translate-y-8">
        <h4 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-8">Agency Ready</h4>
        <ul class="space-y-4 text-xl font-medium text-foreground">
          <li>Client-Ready Reports</li>
          <li>Competitive Benchmarking</li>
          <li>White-Label Support</li>
          <li>Priority Onboarding</li>
        </ul>
      </div>

      <div class="fact-column flex flex-col opacity-0 transform translate-y-8">
        <h4 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-8">Intelligence</h4>
        <ul class="space-y-4 text-xl font-medium text-foreground">
          <li>Answer Placement Score</li>
          <li>Share of Synthesis</li>
          <li>Gap Analysis</li>
        </ul>
      </div>

    </div>

    <!-- The Singular Customer Story -->
    <div class="max-w-4xl mx-auto evidence-story opacity-0 transform translate-y-12">
      <div class="text-center">
        <div class="mb-12 inline-block">
          <div class="w-16 h-16 bg-muted rounded-full mx-auto mb-4 border border-border"></div>
          <div class="text-sm font-medium text-foreground">Built for Agencies</div>
          <div class="text-xs text-muted-foreground">From Day One</div>
        </div>
        
        <blockquote class="text-3xl md:text-5xl font-medium tracking-tight text-foreground leading-tight mb-8">
          "PhantomRank uses a systematic 9-intent framework... We generate 45 strategic prompts per brand, and calculate share of voice using the same metrics enterprise platforms charge $1,500+/month for."
        </blockquote>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Reveal Facts
  gsap.to(".fact-column", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power2.out",
    scrollTrigger: {
      trigger: ".evidence-facts",
      start: "top 75%",
      toggleActions: "play none none reverse",
    }
  });

  // Reveal Story
  gsap.to(".evidence-story", {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: ".evidence-story",
      start: "top 85%",
      toggleActions: "play none none reverse",
    }
  });
</script>
