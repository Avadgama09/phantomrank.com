<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Reveal Facts
  gsap.to(".fact-column", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power2.out",
    scrollTrigger: {
      trigger: ".evidence-facts",
      start: "top 75%",
      toggleActions: "play none none reverse",
    }
  });

  // Reveal Story
  gsap.to(".evidence-story", {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: ".evidence-story",
      start: "top 85%",
      toggleActions: "play none none reverse",
    }
  });
</script>
