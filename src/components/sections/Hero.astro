---
import DotBackground from "../ui/DotBackground.astro";
---

<section
  class="relative mx-auto max-w-7xl px-4 pt-32 pb-16 sm:px-6 lg:px-8 min-h-[90vh] flex flex-col items-center justify-center overflow-hidden"
  id="hero-section"
>
  <DotBackground containerId="hero-section" />

  <div class="text-center z-10">
    <h1
      class="text-3xl sm:text-5xl lg:text-7xl font-medium tracking-tight text-foreground max-w-6xl mx-auto leading-tight"
    >
      <span class="block whitespace-nowrap"
        >In the era of clickless search,</span
      >
      <span
        class="block bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mt-2"
      >
        AI visibility is your new competitive advantage
      </span>
    </h1>

    <p class="mt-8 text-xl text-muted-foreground max-w-3xl mx-auto font-light">
      See how AI engines like ChatGPT, Gemini, Perplexity, Grok, and NVIDIA
      mention your brand, link to your site, and compare you to competitors
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-4">
      <p
        class="text-sm text-muted-foreground/80 font-medium tracking-wide uppercase"
      >
        Tracking AI visibility across:
      </p>
      <div
        class="flex flex-wrap items-center justify-center gap-6 md:gap-10 opacity-70 grayscale transition-all duration-300 hover:grayscale-0 brightness-0 dark:brightness-100"
      >
        <img
          src="/images/Logo/ChatGPTlogo.svg"
          alt="ChatGPT"
          class="h-6 w-auto"
        />
        <img
          src="/images/Logo/Claudelogo.svg"
          alt="Claude"
          class="h-6 w-auto"
        />
        <img
          src="/images/Logo/Gemini-ailogo.svg"
          alt="Gemini"
          class="h-6 w-auto"
        />
        <img src="/images/Logo/GROKlogo.svg" alt="Grok" class="h-6 w-auto" />
        <img
          src="/images/Logo/Nvidialogo.svg"
          alt="NVIDIA"
          class="h-6 w-auto"
        />
        <img
          src="/images/Logo/Perplexitylogo.svg"
          alt="Perplexity"
          class="h-6 w-auto"
        />
      </div>
    </div>

    <div
      class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
    >
      <a
        href="/signup"
        class="btn-primary"
      >
        See a sample AI visibility report
      </a>
      <a
        href="/signup"
        class="btn-secondary"
      >
        Book a 20-minute walkthrough
      </a>
    </div>
  </div>

  <!-- Tiny 20% glimpse of the product interface -->
  <div
    class="mt-24 w-full max-w-5xl mx-auto relative hero-dashboard-glimpse transform-gpu"
  >
    <!-- Gradient fade out at the top and bottom to create the "glimpse" effect -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-background via-transparent to-background z-10 pointer-events-none"
    >
    </div>

    <div
      class="rounded-xl border border-border bg-card shadow-2xl overflow-hidden h-[300px] relative"
    >
      <!-- Top nav bar mockup -->
      <div
        class="h-12 border-b border-border flex items-center px-4 bg-muted/30"
      >
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
        </div>
      </div>
      <!-- Content glimpse -->
      <div class="p-8">
        <img
          src="/images/features/ai-visibility-tracker/VisibilityAnalysis.webp"
          alt="Dashboard Preview"
          class="w-full object-cover object-top opacity-80 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Hero section is instantly rendered for optimal LCP performance
</script>
