---
// Scene 5: Imagine Using It — The Reveal
// Experience: The interface is the protagonist. We design the page *around* the interface.
// Visual & Motion: The dashboard scales up to fill the viewport (The Reveal).
// Then, specific capabilities have bespoke interactions.
---

<section id="scene-reveal" class="relative bg-background border-t border-border pt-32 pb-48 overflow-hidden">
  
  <div class="text-center mb-16 relative z-20">
    <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-foreground mb-6">
      TODO: Copy provided by ChatGPT
    </h2>
    <p class="text-xl text-muted-foreground font-light max-w-2xl mx-auto">
      TODO: Copy provided by ChatGPT
    </p>
  </div>

  <!-- The Big Reveal: Dashboard scaling up -->
  <div class="dashboard-reveal-container relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 mb-48 z-10">
    <div class="dashboard-wrapper rounded-2xl border border-border bg-card shadow-2xl overflow-hidden origin-center transform-gpu">
      <div class="h-12 border-b border-border flex items-center px-4 bg-muted/30">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
        </div>
      </div>
      <img
        src="/images/features/ai-visibility-tracker/VisibilityAnalysis.webp"
        alt="Full Dashboard Reveal"
        class="w-full h-auto object-cover"
      />
      
      <!-- Annotations for AI Visibility (Pinned dashboard interaction) -->
      <div class="annotation absolute top-[30%] left-[20%] opacity-0 transform translate-y-4">
        <div class="bg-background border border-border shadow-lg rounded-lg p-4 w-64">
          <div class="text-sm font-semibold text-primary mb-1">TODO: Copy provided by ChatGPT</div>
          <div class="text-xs text-muted-foreground">TODO: Copy provided by ChatGPT</div>
        </div>
        <div class="w-px h-16 bg-primary absolute -top-16 left-1/2"></div>
        <div class="w-2 h-2 rounded-full bg-primary absolute -top-16 left-1/2 -translate-x-1/2"></div>
      </div>

      <div class="annotation absolute top-[50%] right-[15%] opacity-0 transform translate-y-4">
        <div class="bg-background border border-border shadow-lg rounded-lg p-4 w-64">
          <div class="text-sm font-semibold text-primary mb-1">TODO: Copy provided by ChatGPT</div>
          <div class="text-xs text-muted-foreground">TODO: Copy provided by ChatGPT</div>
        </div>
        <div class="w-px h-24 bg-primary absolute -top-24 left-1/2"></div>
        <div class="w-2 h-2 rounded-full bg-primary absolute -top-24 left-1/2 -translate-x-1/2"></div>
      </div>
    </div>
  </div>

  <!-- Bespoke Interactions for Capabilities -->
  <div class="capabilities-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-48">
    
    <!-- Capability 1: Citation Tracking -->
    <div class="capability flex flex-col md:flex-row items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">TODO: Copy provided by ChatGPT</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">TODO: Copy provided by ChatGPT</p>
      </div>
      <div class="md:w-1/2 relative h-80 w-full bg-muted/20 rounded-2xl border border-border overflow-hidden citation-viz">
        <!-- Interactive citations flying in -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-24 h-24 rounded-full bg-background border border-border flex items-center justify-center z-10 shadow-lg">
            Brand
          </div>
          <div class="citation-node absolute top-[20%] left-[20%] bg-card text-xs px-3 py-1 rounded-full border border-border opacity-0">Reddit</div>
          <div class="citation-node absolute bottom-[20%] left-[30%] bg-card text-xs px-3 py-1 rounded-full border border-border opacity-0">Forbes</div>
          <div class="citation-node absolute top-[30%] right-[20%] bg-card text-xs px-3 py-1 rounded-full border border-border opacity-0">G2</div>
          <div class="citation-node absolute bottom-[30%] right-[25%] bg-card text-xs px-3 py-1 rounded-full border border-border opacity-0">TechCrunch</div>
        </div>
      </div>
    </div>

    <!-- Capability 2: Industry Metrics -->
    <div class="capability flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">TODO: Copy provided by ChatGPT</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">TODO: Copy provided by ChatGPT</p>
      </div>
      <div class="md:w-1/2 relative w-full bg-muted/20 rounded-2xl border border-border p-8 leaderboard-viz">
        <div class="space-y-4">
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-foreground">Competitor A</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-border w-[80%]"></div></div>
          </div>
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-primary">Your Brand</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-primary w-[65%]"></div></div>
          </div>
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-foreground">Competitor B</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-border w-[40%]"></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capability 3: Community Intelligence -->
    <div class="capability flex flex-col md:flex-row items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">TODO: Copy provided by ChatGPT</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">TODO: Copy provided by ChatGPT</p>
      </div>
      <div class="md:w-1/2 relative h-80 w-full bg-muted/20 rounded-2xl border border-border p-8 overflow-hidden threads-viz">
        <div class="thread bg-background border border-border p-4 rounded-lg mb-4 transform translate-y-8 opacity-0 shadow-sm">
          <div class="w-1/2 h-2 bg-muted rounded mb-2"></div>
          <div class="w-full h-2 bg-muted rounded mb-2"></div>
          <div class="w-3/4 h-2 bg-muted rounded"></div>
        </div>
        <div class="thread bg-background border border-border p-4 rounded-lg mb-4 transform translate-y-8 opacity-0 shadow-sm ml-8">
          <div class="w-1/3 h-2 bg-muted rounded mb-2"></div>
          <div class="w-5/6 h-2 bg-muted rounded"></div>
        </div>
        <div class="thread bg-background border border-border p-4 rounded-lg transform translate-y-8 opacity-0 shadow-sm ml-16">
          <div class="w-1/4 h-2 bg-primary/30 rounded mb-2"></div>
          <div class="w-full h-2 bg-muted rounded"></div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 1. Dashboard Reveal & Annotations
  const revealTl = gsap.timeline({
    scrollTrigger: {
      trigger: ".dashboard-reveal-container",
      start: "top 80%",
      end: "top 20%",
      scrub: 1,
    }
  });

  revealTl.fromTo(".dashboard-wrapper", 
    { scale: 0.8, opacity: 0.5, y: 50 }, 
    { scale: 1, opacity: 1, y: 0, duration: 1, ease: "power2.out" }
  );

  gsap.utils.toArray(".annotation").forEach((ann: any, i) => {
    gsap.to(ann, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      delay: i * 0.2,
      scrollTrigger: {
        trigger: ".dashboard-reveal-container",
        start: "center center",
        toggleActions: "play none none reverse",
      }
    });
  });

  // 2. Citation Viz
  gsap.utils.toArray(".citation-node").forEach((node: any) => {
    gsap.to(node, {
      opacity: 1,
      x: 0,
      y: 0,
      duration: 1,
      ease: "elastic.out(1, 0.5)",
      scrollTrigger: {
        trigger: ".citation-viz",
        start: "top 70%",
        toggleActions: "play none none reverse",
      }
    });
  });
  // Setup initial state for citations randomly outwards
  gsap.set(".citation-node", { x: () => gsap.utils.random(-100, 100), y: () => gsap.utils.random(-100, 100) });

  // 3. Leaderboard Viz
  gsap.to(".lb-row", {
    opacity: 1,
    x: 0,
    duration: 0.5,
    stagger: 0.15,
    ease: "power2.out",
    scrollTrigger: {
      trigger: ".leaderboard-viz",
      start: "top 70%",
      toggleActions: "play none none reverse",
    }
  });

  // 4. Threads Viz
  gsap.to(".thread", {
    opacity: 1,
    y: 0,
    duration: 0.5,
    stagger: 0.2,
    ease: "back.out(1.7)",
    scrollTrigger: {
      trigger: ".threads-viz",
      start: "top 70%",
      toggleActions: "play none none reverse",
    }
  });
</script>
