---
interface Props {
  variant?: "preview" | "full";
}

const { variant = "preview" } = Astro.props;

const isPreview = variant === "preview";

const glassCard = "bg-white/60 dark:bg-white/4 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-lg shadow-black/5 dark:shadow-black/20 p-8 rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-primary/10 dark:hover:shadow-primary/5 hover:border-primary/30 dark:hover:border-primary/20 hover:-translate-y-1";

const journeySteps = [
  {
    step: "Step 1",
    name: "Step 1 — See how AIs talk about you",
    href: "/features/ai-visibility-tracker",
    badgeText: "Observation",
    icon: "lucide:radar",
    iconClass: "bg-blue-500/10 text-blue-400",
    bodyText: `We run your category queries across ChatGPT, Gemini, Claude, Grok, and Perplexity, covering real buyer intents from ‘what are my options?’ to ‘which one should I buy?’
Then we collapse noisy, non‑deterministic answers into clear states — absent, mentioned, recommended, or endorsed — so you can track movement without pretending the data is exact.`
  },
  {
    step: "Step 2",
    name: "Step 2 — See where you’re winning or losing",
    href: "/features/industry-metrics",
    badgeText: "Benchmarking & gaps",
    icon: "lucide:bar-chart-3",
    iconClass: "bg-purple-500/10 text-purple-400",
    bodyText: `We map 15–20 brands in your niche into Leaders, Challengers, and Niche specialists, then measure your AI Share of Voice, Share of Synthesis, and Answer Placement Score.
Each audit surfaces the buying criteria AIs actually use and 5 concrete information gaps, giving you a prioritized backlog instead of another vanity dashboard.`
  },
  {
    step: "Step 3",
    name: "Step 3 — See where to intervene upstream",
    href: "/features/gso",
    badgeText: "Information supply chain",
    icon: "lucide:messages-square",
    iconClass: "bg-pink-500/10 text-pink-400",
    bodyText: `We trace which domains AIs rely on in your category — government, media, reviews, directories, marketplaces, communities like Reddit, and company sites.
You get a clear upstream playbook: which sites to win as citations, which communities to seed, and which proof assets to ship first so future answers move in your favor.`
  }
];
---

<section class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
  <div class="text-center mb-16">
    <div
      class="reveal inline-flex items-center gap-2 px-3 py-1 text-primary text-lg font-semibold"
    >
      {isPreview ? "How PhantomRank helps" : "How the platform works"}
    </div>
    <h2
      class="reveal text-3xl md:text-4xl font-bold tracking-tight text-foreground mb-4"
    >
      {isPreview
        ? "From AI answers to a demand playbook"
        : "From observation to intervention"}
    </h2>
    <p class="reveal text-xl text-muted-foreground max-w-2xl mx-auto">
      {isPreview
        ? "We don’t sell scores. We show how AIs talk about you, where you’re losing ground, and which levers to pull upstream."
        : "Three stages: see where you stand, see why, and see where to intervene in the AI supply chain."}
    </p>
  </div>

  {/* ── Live Features ── */}
  <div class="mb-16">
    {!isPreview && (
      <h3 class="reveal text-sm font-semibold uppercase tracking-wider text-primary mb-8 text-center">
        Live Now
      </h3>
    )}
    <div class="grid gap-6 md:grid-cols-3">
      {journeySteps.map((step) => (
        <a
          href={step.href}
          class:list={["reveal group", glassCard]}
        >
          <div
            class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl ${step.iconClass}`}
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              {step.icon === "lucide:radar" && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.348 14.652a3.75 3.75 0 010-5.304m5.304 0a3.75 3.75 0 010 5.304m-7.425 2.121a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.808 3.808 9.981 0 13.789M12 12h.008v.008H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                />
              )}
              {step.icon === "lucide:bar-chart-3" && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 3v18h18M7 16v-3m4 3v-7m4 7V9m4 7v-5"
                />
              )}
              {step.icon === "lucide:messages-square" && (
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20 12c0 1.657-1.343 3-3 3h-1l-4 4V15H7c-1.657 0-3-1.343-3-3V7c0-1.657 1.343-3 3-3h10c1.657 0 3 1.343 3 3v5z"
                />
              )}
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
              {step.name}
            </h3>
            <span class="inline-flex items-center rounded-full bg-green-500/10 px-2 py-0.5 text-xs font-medium text-green-400">
              {step.badgeText}
            </span>
          </div>
          <p class="text-muted-foreground">{step.bodyText}</p>
        </a>
      ))}
    </div>
  </div>
</section>

