---
---

<section id="scene-reveal" class="relative bg-background border-t border-border pt-32 pb-48 overflow-hidden">
  
  <!-- Interactive Dot Distortion Background -->
  <canvas
    id="dot-distortion-canvas-3"
    class="absolute inset-0 z-0 pointer-events-none opacity-30 dark:opacity-40 mix-blend-screen"
  ></canvas>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,var(--background)_100%)] z-0 pointer-events-none"></div>

  <div class="text-center mb-16 relative z-20">
    <h2 class="text-3xl md:text-5xl font-medium tracking-tight text-foreground mb-6">
      From observation to intervention
    </h2>
    <p class="text-xl text-muted-foreground font-light max-w-2xl mx-auto">
      Three stages: see where you stand, see why, and see where to intervene in the AI supply chain.
    </p>
  </div>

  <!-- The Big Reveal: Dashboard scaling up -->
  <div class="dashboard-reveal-container relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 mb-48 z-10">
    <div class="dashboard-wrapper rounded-2xl border border-border bg-card shadow-2xl overflow-hidden origin-center transform-gpu">
      <div class="h-12 border-b border-border flex items-center px-4 bg-muted/30">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
        </div>
      </div>
      <img
        src="/images/features/ai-visibility-tracker/VisibilityAnalysis.webp"
        alt="Full Dashboard Reveal"
        class="w-full h-auto object-cover"
      />
      
      <!-- Annotations for AI Visibility (Pinned dashboard interaction) -->
      <div class="annotation absolute top-[30%] left-[20%] opacity-0 transform translate-y-4">
        <div class="bg-background border border-border shadow-lg rounded-lg p-4 w-64">
          <div class="text-sm font-semibold text-primary mb-1">Observation</div>
          <div class="text-xs text-muted-foreground">See how AIs talk about you</div>
        </div>
        <div class="w-px h-16 bg-primary absolute -top-16 left-1/2"></div>
        <div class="w-2 h-2 rounded-full bg-primary absolute -top-16 left-1/2 -translate-x-1/2"></div>
      </div>

      <div class="annotation absolute top-[50%] right-[15%] opacity-0 transform translate-y-4">
        <div class="bg-background border border-border shadow-lg rounded-lg p-4 w-64">
          <div class="text-sm font-semibold text-primary mb-1">Benchmarking & gaps</div>
          <div class="text-xs text-muted-foreground">See where you’re winning or losing</div>
        </div>
        <div class="w-px h-24 bg-primary absolute -top-24 left-1/2"></div>
        <div class="w-2 h-2 rounded-full bg-primary absolute -top-24 left-1/2 -translate-x-1/2"></div>
      </div>
    </div>
  </div>

  <!-- Bespoke Interactions for Capabilities -->
  <div class="capabilities-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-48">
    
    <!-- Capability 1: Citation Tracking -->
    <div class="capability flex flex-col md:flex-row items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">See how AIs talk about you</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">See your visibility layers at a glance: mentions, citations, crawl-pool gaps, and your semantic resonance score — for one brand, across five AI engines.</p>
      </div>
      <div class="md:w-1/2 relative h-[500px] w-full bg-muted/20 rounded-2xl border border-border overflow-hidden citation-viz">
        
        <!-- Connection Lines -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
          <style>
            .connection-line {
              stroke: hsl(var(--primary) / 0.4);
              stroke-width: 1.5;
              stroke-dasharray: 6 6;
              animation: flow 20s linear infinite;
              opacity: 0;
            }
            @keyframes flow {
              to { stroke-dashoffset: -200; }
            }
          </style>
          <line x1="50%" y1="50%" x2="50%" y2="15%" class="connection-line" />
          <line x1="50%" y1="50%" x2="73%" y2="23%" class="connection-line" />
          <line x1="50%" y1="50%" x2="84%" y2="44%" class="connection-line" />
          <line x1="50%" y1="50%" x2="80%" y2="68%" class="connection-line" />
          <line x1="50%" y1="50%" x2="62%" y2="83%" class="connection-line" />
          <line x1="50%" y1="50%" x2="38%" y2="83%" class="connection-line" />
          <line x1="50%" y1="50%" x2="20%" y2="68%" class="connection-line" />
          <line x1="50%" y1="50%" x2="16%" y2="44%" class="connection-line" />
          <line x1="50%" y1="50%" x2="27%" y2="23%" class="connection-line" />
        </svg>

        <!-- Interactive citations flying in -->
        <div class="absolute inset-0 pointer-events-none">
          <div class="absolute top-[50%] left-[50%] -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full bg-background border border-border flex items-center justify-center z-20 shadow-[0_0_30px_rgba(var(--primary),0.15)] font-medium text-foreground">
            Brand
          </div>
          
          <div class="citation-node absolute top-[15%] left-[50%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Twitterlogo.svg" alt="Twitter" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[23%] left-[73%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/G2Reviewlogo.svg" alt="G2 Review" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[44%] left-[84%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Instagramlogo.svg" alt="Instagram" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[68%] left-[80%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Metalogo.svg" alt="Meta" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[83%] left-[62%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Quoralogo.svg" alt="Quora" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[83%] left-[38%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Redditlogo.svg" alt="Reddit" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[68%] left-[20%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Sourceforgelogo.svg" alt="Sourceforge" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[44%] left-[16%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Threadslogo.svg" alt="Threads" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
          <div class="citation-node absolute top-[23%] left-[27%] bg-card p-3 rounded-full border border-border opacity-0 shadow-sm flex items-center justify-center z-10">
            <img src="/images/Logo/Facebooklogo.svg" alt="Facebook" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
          </div>
        </div>
      </div>
    </div>

    <!-- Capability 2: Industry Metrics -->
    <div class="capability flex flex-col md:flex-row-reverse items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">See where you're winning or losing</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">A live leaderboard of your category: AI Share of Voice, Share of Synthesis, and Answer Placement, benchmarked against 15–20 competitors.</p>
      </div>
      <div class="md:w-1/2 relative w-full bg-muted/20 rounded-2xl border border-border p-8 leaderboard-viz">
        <div class="space-y-4">
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-foreground">Competitor A</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-border w-[80%]"></div></div>
          </div>
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-primary">Your Brand</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-primary w-[65%]"></div></div>
          </div>
          <div class="lb-row flex items-center justify-between opacity-0 transform translate-x-8">
            <div class="font-medium text-foreground">Competitor B</div>
            <div class="w-1/2 h-2 bg-muted rounded-full overflow-hidden"><div class="h-full bg-border w-[40%]"></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capability 3: Community Intelligence -->
    <div class="capability flex flex-col md:flex-row items-center gap-16">
      <div class="md:w-1/2">
        <h3 class="text-3xl font-medium text-foreground mb-4">See where to intervene upstream</h3>
        <p class="text-lg text-muted-foreground font-light mb-8">Information gaps turned into a content calendar — the exact topics AI is currently answering badly, ranked by opportunity.</p>
      </div>
      <div class="md:w-1/2 relative h-80 w-full bg-muted/20 rounded-2xl border border-border p-8 overflow-hidden threads-viz">
        <div class="thread bg-background border border-border p-4 rounded-lg mb-4 transform translate-y-8 opacity-0 shadow-sm">
          <div class="w-1/2 h-2 bg-muted rounded mb-2"></div>
          <div class="w-full h-2 bg-muted rounded mb-2"></div>
          <div class="w-3/4 h-2 bg-muted rounded"></div>
        </div>
        <div class="thread bg-background border border-border p-4 rounded-lg mb-4 transform translate-y-8 opacity-0 shadow-sm ml-8">
          <div class="w-1/3 h-2 bg-muted rounded mb-2"></div>
          <div class="w-5/6 h-2 bg-muted rounded"></div>
        </div>
        <div class="thread bg-background border border-border p-4 rounded-lg transform translate-y-8 opacity-0 shadow-sm ml-16">
          <div class="w-1/4 h-2 bg-primary/30 rounded mb-2"></div>
          <div class="w-full h-2 bg-muted rounded"></div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 1. Dashboard Reveal & Annotations
  const revealTl = gsap.timeline({
    scrollTrigger: {
      trigger: ".dashboard-reveal-container",
      start: "top 80%",
      end: "top 20%",
      scrub: 1,
    }
  });

  revealTl.fromTo(".dashboard-wrapper", 
    { scale: 0.8, opacity: 0.5, y: 50 }, 
    { scale: 1, opacity: 1, y: 0, duration: 1, ease: "power2.out" }
  );

  gsap.utils.toArray(".annotation").forEach((ann: any, i) => {
    gsap.to(ann, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      delay: i * 0.2,
      scrollTrigger: {
        trigger: ".dashboard-reveal-container",
        start: "center center",
        toggleActions: "play none none reverse",
      }
    });
  });

  // 2. Citation Viz
  gsap.utils.toArray(".citation-node").forEach((node: any) => {
    gsap.to(node, {
      opacity: 1,
      x: 0,
      y: 0,
      duration: 1.2,
      ease: "elastic.out(1, 0.5)",
      scrollTrigger: {
        trigger: ".citation-viz",
        start: "top 70%",
        toggleActions: "play none none reverse",
      }
    });
  });

  gsap.to(".connection-line", {
    opacity: 1,
    duration: 1,
    stagger: 0.1,
    scrollTrigger: {
      trigger: ".citation-viz",
      start: "top 70%",
      toggleActions: "play none none reverse",
    }
  });

  // Setup initial state for citations randomly outwards
  gsap.set(".citation-node", { 
    x: () => gsap.utils.random(-150, 150), 
    y: () => gsap.utils.random(-150, 150),
    xPercent: -50,
    yPercent: -50
  });

  // 3. Leaderboard Viz
  gsap.to(".lb-row", {
    opacity: 1,
    x: 0,
    duration: 0.5,
    stagger: 0.15,
    ease: "power2.out",
    scrollTrigger: {
      trigger: ".leaderboard-viz",
      start: "top 70%",
      toggleActions: "play none none reverse",
    }
  });

  // 4. Threads Viz
  gsap.to(".thread", {
    opacity: 1,
    y: 0,
    duration: 0.5,
    stagger: 0.2,
    ease: "back.out(1.7)",
    scrollTrigger: {
      trigger: ".threads-viz",
      start: "top 70%",
      toggleActions: "play none none reverse",
    }
  });

  // --- Dot Distortion Canvas Effect ---
  const initCanvas = () => {
    const canvas = document.getElementById("dot-distortion-canvas-3") as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const section = document.getElementById("scene-reveal");
    if (!section) return;

    let width = 0;
    let height = 0;
    let dots: { baseX: number; baseY: number; x: number; y: number }[] = [];

    // Configuration
    const spacing = 22; // Space between dots
    const radius = 1.2; // Size of dots
    const mouseRadius = 150; // How far the mouse repels
    const repelForce = 35; // How strongly dots are pushed

    let mouse = { x: -1000, y: -1000 };
    let animationFrameId: number;

    const createDots = () => {
      dots = [];
      const rows = Math.ceil(height / spacing) + 1;
      const cols = Math.ceil(width / spacing) + 1;

      const offsetX = (width - (cols - 1) * spacing) / 2;
      const offsetY = (height - (rows - 1) * spacing) / 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = offsetX + c * spacing;
          const y = offsetY + r * spacing;
          dots.push({ baseX: x, baseY: y, x, y });
        }
      }
    };

    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      width = section.clientWidth;
      height = section.clientHeight;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);
      createDots();
    };

    const handleMouseMove = (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    };

    const handleMouseLeave = () => {
      mouse.x = -1000;
      mouse.y = -1000;
    };

    const animate = () => {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgba(59, 130, 246, 0.4)"; 

      const time = performance.now() * 0.001;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dx = mouse.x - dot.baseX;
        const dy = mouse.y - dot.baseY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        let targetX = dot.baseX;
        let targetY = dot.baseY;

        targetX += Math.sin(time + dot.baseX * 0.01) * 2;
        targetY += Math.cos(time + dot.baseY * 0.01) * 2;

        if (dist < mouseRadius) {
          const force = (mouseRadius - dist) / mouseRadius;
          const angle = Math.atan2(dy, dx);
          targetX -= Math.cos(angle) * force * repelForce;
          targetY -= Math.sin(angle) * force * repelForce;
        }

        dot.x += (targetX - dot.x) * 0.15;
        dot.y += (targetY - dot.y) * 0.15;

        ctx.beginPath();
        ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(animate);
    };

    window.addEventListener("resize", resize);
    section.addEventListener("mousemove", handleMouseMove);
    section.addEventListener("mouseleave", handleMouseLeave);

    resize();
    animate();

    return () => {
      window.removeEventListener("resize", resize);
      section.removeEventListener("mousemove", handleMouseMove);
      section.removeEventListener("mouseleave", handleMouseLeave);
      cancelAnimationFrame(animationFrameId);
    };
  };

  let cleanupCanvas3: (() => void) | undefined;
  
  const setupCanvas3 = () => {
    if (cleanupCanvas3) cleanupCanvas3();
    cleanupCanvas3 = initCanvas();
  };

  setupCanvas3();
  document.addEventListener("astro:page-load", setupCanvas3);
</script>
