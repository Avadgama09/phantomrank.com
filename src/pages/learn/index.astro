---
// src/pages/learn/index.astro — Clean Editorial Resource Library for PhantomRank Learn
import Layout from "../../layouts/Layout.astro";
import Schema from "../../components/seo/Schema.astro";
import PortableText from "../../components/sanity/PortableText.astro";
import { sanityFetch } from "../../sanity/lib/client";
import {
  LEARN_HUB_SETTINGS_QUERY,
  ALL_MAJOR_TOPICS_QUERY,
  ALL_CLUSTERS_QUERY,
  ALL_PUBLISHED_ARTICLES_QUERY,
  PUBLISHED_RESEARCH_STUDIES_QUERY,
} from "../../sanity/lib/queries";

// Fetch Sanity data at build time
const hubSettings = await sanityFetch<any>({
  query: LEARN_HUB_SETTINGS_QUERY,
});

const clusters = await sanityFetch<any[]>({
  query: ALL_CLUSTERS_QUERY,
});

const publishedArticles = await sanityFetch<any[]>({
  query: ALL_PUBLISHED_ARTICLES_QUERY,
});

const publishedResearch = await sanityFetch<any[]>({
  query: PUBLISHED_RESEARCH_STUDIES_QUERY,
});

// Calculate reading time helper (200 Words Per Minute)
function calculateReadingTime(body: any[] = []): number | null {
  if (!body || body.length === 0) return null;
  
  let textContent = "";
  for (const block of body) {
    if (block._type === "block" && Array.isArray(block.children)) {
      for (const child of block.children) {
        if (child.text) textContent += " " + child.text;
      }
    }
  }
  
  const words = textContent.trim().split(/\s+/).filter(Boolean).length;
  if (words < 30) return null;
  return Math.max(1, Math.ceil(words / 200));
}

// Restrained, editorial defaults
const seoTitle = hubSettings?.seoTitle || "AI Search, AI Visibility & AI SEO | PhantomRank Learn";
const seoDescription = hubSettings?.seoDescription || "Practical guides on how AI search finds, cites and describes brands.";
const heroEyebrow = hubSettings?.heroEyebrow || "PhantomRank Learn";
const heroH1 = hubSettings?.heroH1 || "AI Search, AI Visibility & AI SEO";

const hasResearch = (publishedResearch || []).length > 0;
const hasArticles = (publishedArticles || []).length > 0;

// Format articles feed
const formattedFeed = (publishedArticles || []).map((a) => ({
  id: a._id,
  title: a.title,
  excerpt: a.excerpt || "",
  href: `/learn/${a.primaryCluster?.slug || "foundations"}/${a.slug}`,
  clusterTitle: a.primaryCluster?.title || "Foundations",
  clusterSlug: a.primaryCluster?.slug || "foundations",
  contentType: a.contentType || "guide",
  readingTime: calculateReadingTime(a.body),
  publishedDate: a.publishedAt ? new Date(a.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "",
  authorName: a.author?.name || "PhantomRank",
}));

// Fallback clusters list if Sanity dataset query is empty
const defaultClusters = [
  { title: "Foundations", slug: "foundations" },
  { title: "Measurement", slug: "measurement" },
  { title: "Diagnosis", slug: "diagnosis" },
  { title: "Optimisation", slug: "optimisation" },
  { title: "Operations", slug: "operations" },
  { title: "Evidence", slug: "evidence" },
];

const clusterList = (clusters && clusters.length > 0)
  ? clusters.map((c) => ({ title: c.title, slug: c.slug }))
  : defaultClusters;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
  ]}
>
  <Schema
    slot="head"
    type="CollectionPage"
    data={{
      collectionPage: {
        name: seoTitle,
        description: seoDescription,
        url: "/learn",
        isPartOfUrl: "/",
        isPartOfName: "PhantomRank",
        hasPart: clusterList.map((c) => ({
          name: c.title,
          url: `/learn/${c.slug}`,
        })),
      },
    }}
  />

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <!-- ══════════════════════════════════════════════════════════════
         1. HERO SECTION (Clean, Restrained Editorial Design)
    ══════════════════════════════════════════════════════════════ -->
    <header class="border-b border-border pb-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {heroEyebrow}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        {heroH1}
      </h1>
      <div class="mt-4 text-base text-muted-foreground max-w-2xl leading-relaxed">
        {hubSettings?.heroIntro ? (
          <PortableText value={hubSettings.heroIntro} />
        ) : (
          <p>{seoDescription}</p>
        )}
      </div>

      <!-- ── Major Topic Text Links ── -->
      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm font-semibold">
        <a
          href="/learn/ai-visibility/"
          class="inline-flex items-center text-primary hover:underline"
        >
          Explore AI Visibility <span class="ml-1 text-xs">→</span>
        </a>
        <a
          href="/learn/ai-seo/"
          class="inline-flex items-center text-primary hover:underline"
        >
          Explore AI SEO <span class="ml-1 text-xs">→</span>
        </a>
      </div>
    </header>

    <!-- ══════════════════════════════════════════════════════════════
         2. CLUSTER NAVIGATION (Simple Horizontal Text/Pill Bar)
    ══════════════════════════════════════════════════════════════ -->
    <nav aria-label="Topic Clusters" class="py-8 border-b border-border">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-2 text-xs font-medium text-muted-foreground uppercase tracking-wider">
          Categories:
        </span>
        {clusterList.map((c) => (
          <a
            href={`/learn/${c.slug}`}
            class="rounded-full border border-border bg-card px-4 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-primary/50 hover:bg-muted/40"
          >
            {c.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════
         3. LATEST GUIDES SECTION (Displays Only Real Sanity Content)
    ══════════════════════════════════════════════════════════════ -->
    <main class="py-12">
      <h2 class="text-xl font-bold text-foreground mb-8">
        Latest Guides
      </h2>

      {hasArticles ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {formattedFeed.map((item) => (
            <article class="flex flex-col justify-between rounded-lg border border-border bg-card p-6 transition-all hover:border-primary/40 hover:shadow-xs">
              <div>
                <div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
                  <span class="font-semibold text-primary">{item.clusterTitle}</span>
                  <span class="uppercase tracking-wider text-[10px]">{item.contentType}</span>
                </div>
                <h3 class="text-base font-semibold text-foreground leading-snug">
                  <a href={item.href} class="hover:text-primary transition-colors">
                    {item.title}
                  </a>
                </h3>
                {item.excerpt && (
                  <p class="mt-2 text-xs leading-relaxed text-muted-foreground line-clamp-3">
                    {item.excerpt}
                  </p>
                )}
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-border/50 pt-4 text-[11px] text-muted-foreground">
                <span>{item.authorName}</span>
                {item.readingTime && <span>{item.readingTime} min read</span>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        /* Restrained, elegant empty state when zero articles are published */
        <div class="rounded-lg border border-dashed border-border p-10 text-center">
          <p class="text-sm font-medium text-foreground">
            No published articles yet
          </p>
          <p class="mt-1 text-xs text-muted-foreground max-w-md mx-auto leading-relaxed">
            Foundational guides, frameworks, and empirical teardowns are currently in editorial review. Explore our topic category pages above.
          </p>
        </div>
      )}
    </main>

    <!-- ══════════════════════════════════════════════════════════════
         4. RESEARCH SECTION (Renders ONLY when real studies exist)
    ══════════════════════════════════════════════════════════════ -->
    {hasResearch && (
      <section class="border-t border-border pt-12">
        <h2 class="text-xl font-bold text-foreground mb-6">
          Research & Empirical Studies
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          {publishedResearch.map((study: any) => (
            <article class="rounded-lg border border-border bg-card p-6 transition-all hover:border-primary/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-primary">
                Research Study
              </span>
              <h3 class="mt-2 text-base font-bold text-foreground">
                <a href={`/learn/evidence/${study.slug}`} class="hover:text-primary transition-colors">
                  {study.title}
                </a>
              </h3>
              {study.excerpt && (
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground line-clamp-3">
                  {study.excerpt}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
