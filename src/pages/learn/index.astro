---
// src/pages/learn/index.astro — Clean Editorial Resource Library for PhantomRank Learn
import Layout from "../../layouts/Layout.astro";
import Schema from "../../components/seo/Schema.astro";
import DotBackground from "../../components/ui/DotBackground.astro";
import { getCollection } from "astro:content";

// Fetch Astro Content Collection (MDX files)
const mdxArticles = await getCollection("learn", (entry) => entry.data.pageType === "article" && !entry.data.draft);

// Calculate reading time helper (200 Words Per Minute)
function calculateMDXReadingTime(body: string = ""): number {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

// Format MDX feed
const formattedFeed = mdxArticles.map((a) => {
  const clusterSlug = a.data.cluster || "foundations";
  const clusterTitle = clusterSlug.charAt(0).toUpperCase() + clusterSlug.slice(1);
  return {
    id: a.slug,
    title: a.data.title,
    excerpt: a.data.excerpt || a.data.description || "",
    href: `/learn/${clusterSlug}/${a.slug.split("/").pop()}`,
    clusterTitle,
    clusterSlug,
    contentType: a.data.contentType || "guide",
    readingTime: calculateMDXReadingTime(a.body),
    publishedDate: a.data.publishedDate ? new Date(a.data.publishedDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "",
    authorName: a.data.author || "PhantomRank Editorial Team",
  };
});

// Restrained, editorial defaults
const seoTitle = "AI Search, AI Visibility & AI SEO | PhantomRank Learn";
const seoDescription = "Practical guides on how AI search finds, cites and describes brands.";
const heroEyebrow = "PhantomRank Learn";
const heroH1 = "AI Search, AI Visibility & AI SEO";

const hasArticles = formattedFeed.length > 0;

// Locked 6 Clusters list
const clusterList = [
  { title: "Foundations", slug: "foundations" },
  { title: "Measurement", slug: "measurement" },
  { title: "Diagnosis", slug: "diagnosis" },
  { title: "Optimisation", slug: "optimisation" },
  { title: "Operations", slug: "operations" },
  { title: "Evidence", slug: "evidence" },
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
  ]}
>
  <Schema
    slot="head"
    type="CollectionPage"
    data={{
      collectionPage: {
        name: seoTitle,
        description: seoDescription,
        url: "/learn",
        isPartOfUrl: "/",
        isPartOfName: "PhantomRank",
        hasPart: clusterList.map((c) => ({
          name: c.title,
          url: `/learn/${c.slug}`,
        })),
      },
    }}
  />

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <!-- ══════════════════════════════════════════════════════════════
         1. HERO SECTION (Clean Editorial Design with Homepage Hero Styling)
    ══════════════════════════════════════════════════════════════ -->
    <header id="learn-hero" class="relative mx-auto max-w-7xl px-4 pt-24 pb-12 sm:px-6 lg:px-8 flex flex-col items-center justify-center overflow-hidden text-center border-b border-border">
      <DotBackground containerId="learn-hero" />
      <div class="relative z-10 text-center">
        <p class="text-sm text-muted-foreground/80 font-medium tracking-wide uppercase mb-3">
          {heroEyebrow}
        </p>
        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-medium tracking-tight text-foreground max-w-6xl mx-auto leading-tight">
          AI Search, AI Visibility
          <span class="block bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mt-2">
            & AI SEO
          </span>
        </h1>
        <div class="mt-6 text-xl text-muted-foreground max-w-3xl mx-auto font-light leading-relaxed">
          <p>{seoDescription}</p>
        </div>

        <!-- ── Major Topic Text Links ── -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm font-semibold">
          <a
            href="/learn/ai-visibility/"
            class="btn-secondary"
          >
            Explore AI Visibility →
          </a>
          <a
            href="/learn/ai-seo/"
            class="btn-primary"
          >
            Explore AI SEO →
          </a>
        </div>
      </div>
    </header>

    <!-- ══════════════════════════════════════════════════════════════
         2. CLUSTER NAVIGATION (Simple Horizontal Text/Pill Bar)
    ══════════════════════════════════════════════════════════════ -->
    <nav aria-label="Topic Clusters" class="py-8 border-b border-border">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-2 text-xs font-medium text-muted-foreground uppercase tracking-wider">
          Categories:
        </span>
        {clusterList.map((c) => (
          <a
            href={`/learn/${c.slug}`}
            class="rounded-full border border-border bg-card px-4 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-primary/50 hover:bg-muted/40"
          >
            {c.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════
         3. LATEST GUIDES SECTION (Displays Only Real Sanity Content)
    ══════════════════════════════════════════════════════════════ -->
    <main class="py-12">
      <h2 class="text-xl font-bold text-foreground mb-8">
        Latest Guides
      </h2>

      {hasArticles ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {formattedFeed.map((item) => (
            <article class="flex flex-col justify-between rounded-lg border border-border bg-card p-6 transition-all hover:border-primary/40 hover:shadow-xs">
              <div>
                <div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
                  <span class="font-semibold text-primary">{item.clusterTitle}</span>
                  <span class="uppercase tracking-wider text-[10px]">{item.contentType}</span>
                </div>
                <h3 class="text-base font-semibold text-foreground leading-snug">
                  <a href={item.href} class="hover:text-primary transition-colors">
                    {item.title}
                  </a>
                </h3>
                {item.excerpt && (
                  <p class="mt-2 text-xs leading-relaxed text-muted-foreground line-clamp-3">
                    {item.excerpt}
                  </p>
                )}
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-border/50 pt-4 text-[11px] text-muted-foreground">
                <span>{item.authorName}</span>
                {item.readingTime && <span>{item.readingTime} min read</span>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        /* Restrained, elegant empty state when zero articles are published */
        <div class="rounded-lg border border-dashed border-border p-10 text-center">
          <p class="text-sm font-medium text-foreground">
            No published articles yet
          </p>
          <p class="mt-1 text-xs text-muted-foreground max-w-md mx-auto leading-relaxed">
            Foundational guides, frameworks, and empirical teardowns are currently in editorial review. Explore our topic category pages above.
          </p>
        </div>
      )}
    </main>

  </div>
</Layout>
