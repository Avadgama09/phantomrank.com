---
// src/pages/learn/ai-seo/[cluster]/index.astro
// Cluster Landing Page for /learn/ai-seo/[cluster] (Foundations, Measurement, Diagnosis, Optimisation, Operations, Evidence)
import ClusterLayout from "../../../../layouts/ClusterLayout.astro";
import PortableText from "../../../../components/sanity/PortableText.astro";
import { sanityFetch } from "../../../../sanity/lib/client";
import { ALL_CLUSTERS_QUERY, CLUSTER_BY_SLUG_QUERY, ARTICLES_IN_CLUSTER_QUERY } from "../../../../sanity/lib/queries";

export async function getStaticPaths() {
  // Get all clusters under ai-seo pillar
  const clusters = await sanityFetch<any[]>({
    query: ALL_CLUSTERS_QUERY,
    params: { pillarSlug: "ai-seo" },
  });

  // Default fallback paths if dataset is not yet seeded
  if (!clusters || clusters.length === 0) {
    const lockedSlugs = ["foundations", "measurement", "diagnosis", "optimisation", "operations", "evidence"];
    return lockedSlugs.map((slug) => ({
      params: { cluster: slug },
    }));
  }

  return clusters.map((c) => ({
    params: { cluster: c.slug },
  }));
}

const { cluster: clusterSlug } = Astro.params;

const clusterData = await sanityFetch<any>({
  query: CLUSTER_BY_SLUG_QUERY,
  params: { pillarSlug: "ai-seo", clusterSlug },
});

const siblingClusters = await sanityFetch<any[]>({
  query: ALL_CLUSTERS_QUERY,
  params: { pillarSlug: "ai-seo" },
});

const clusterArticles = await sanityFetch<any[]>({
  query: ARTICLES_IN_CLUSTER_QUERY,
  params: { pillarSlug: "ai-seo", clusterSlug },
});

const title = clusterData?.title || clusterSlug.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
const description = clusterData?.shortDescription || `Guide and articles for the ${title} cluster under AI SEO.`;

const formattedSiblings = (siblingClusters || []).map((s) => ({
  slug: s.slug,
  title: s.title,
  href: `/learn/ai-seo/${s.slug}`,
}));

const formattedArticles = (clusterArticles || []).map((a) => ({
  slug: a.slug,
  title: a.title,
  description: a.excerpt || "",
  href: `/learn/ai-seo/${clusterSlug}/${a.slug}`,
  publisheddate: a.publishedAt || "",
}));
---

<ClusterLayout
  title={clusterData?.seo?.title || `${title} — AI SEO Cluster | PhantomRank`}
  description={clusterData?.seo?.description || description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
    { name: "AI SEO", href: "/learn/ai-seo" },
    { name: title },
  ]}
  hubTitle="AI SEO"
  hubSlug="ai-seo"
  clusters={formattedSiblings}
  currentCluster={clusterSlug}
  articles={formattedArticles}
>
  {clusterData?.introduction ? (
    <PortableText value={clusterData.introduction} />
  ) : (
    <div class="prose prose-lg max-w-none text-muted-foreground">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  )}

  {formattedArticles.length > 0 && (
    <div class="mt-12 border-t border-border pt-10">
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
        Articles in {title}
      </h2>
      <div class="mt-6 grid gap-4">
        {formattedArticles.map((article) => (
          <a
            href={article.href}
            class="group flex flex-col rounded-lg border border-border bg-card p-5 transition-all hover:border-primary/40 hover:shadow-sm"
          >
            <h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors">
              {article.title}
            </h3>
            {article.description && (
              <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">
                {article.description}
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  )}
</ClusterLayout>
