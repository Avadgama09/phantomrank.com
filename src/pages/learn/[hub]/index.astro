---
// src/pages/learn/[hub]/index.astro
import PillarLayout from "../../../layouts/PillarLayout.astro";
import { getCollection } from "astro:content";
import { hubs } from "../../../config/hubs";

type Frontmatter = {
  title?: string;
  description?: string;
  seo?: { title?: string; description?: string };
  featuredimage?: { src?: string; alt?: string };
  publisheddate?: string;
  updateddate?: string;
};

type MdxModule = {
  default: any;
  frontmatter?: Frontmatter;
};

export async function getStaticPaths() {
  const pillarModules = import.meta.glob<MdxModule>(
    "../../../content/learn/*/_pillar.mdx",
    { eager: true },
  );

  const clusterModules = import.meta.glob<MdxModule>(
    "../../../content/learn/*/*/_index.mdx",
    { eager: true },
  );

  const { getCollection } = await import("astro:content");
  const allEntries = await getCollection("learn");

  return Object.entries(pillarModules).map(([path, mod]) => {
    const cleanPath = path.replace(/\\/g, "/");
    const parts = cleanPath.split("/");
    const hub = parts[parts.indexOf("learn") + 1];
    const hubMeta = hubs.find((h) => h.slug === hub);

    const clusters = Object.entries(clusterModules)
      .filter(([cPath]) => {
        const cleanCPath = cPath.replace(/\\/g, "/");
        const cParts = cleanCPath.split("/");
        return cParts[cParts.indexOf("learn") + 1] === hub;
      })
      .map(([cPath, cMod]) => {
        const cleanCPath = cPath.replace(/\\/g, "/");
        const cParts = cleanCPath.split("/");
        const clusterSlug = cParts[cParts.indexOf("learn") + 2];
        const fallbackTitle = clusterSlug
          .replace(/-/g, " ")
          .replace(/\b\w/g, (c) => c.toUpperCase());

        const articleCount = allEntries.filter((e) => {
          const cleanId = e.id.replace(/\\/g, "/");
          const p = cleanId.split("/");
          return (
            p[0] === hub &&
            p[1] === clusterSlug &&
            !cleanId.endsWith("_index.mdx") &&
            !cleanId.endsWith("_pillar.mdx")
          );
        }).length;

        const fullTitle = cMod.frontmatter?.title || fallbackTitle;
        const shortTitle = fullTitle.includes(":")
          ? fullTitle.split(":")[0].trim()
          : fullTitle;

        return {
          slug: clusterSlug,
          title: shortTitle,
          href: `/learn/${hub}/${clusterSlug}`,
          description: cMod.frontmatter?.description || "",
          articleCount,
        };
      })
      .sort((a, b) => a.title.localeCompare(b.title));

    // Total article count across this hub
    const articleEntries = allEntries.filter((e) => {
      const cleanId = e.id.replace(/\\/g, "/");
      const p = cleanId.split("/");
      return (
        p[0] === hub &&
        !cleanId.endsWith("_index.mdx") &&
        !cleanId.endsWith("_pillar.mdx")
      );
    });
    const totalArticleCount = articleEntries.length;

    // Recent articles for the feed section — up to 9, most recent first
    const recentArticles = articleEntries
      .sort((a, b) => {
        const da = a.data.publisheddate || "";
        const db = b.data.publisheddate || "";
        return db.localeCompare(da);
      })
      .slice(0, 9)
      .map((e) => {
        const cleanId = e.id.replace(/\\/g, "/");
        const p = cleanId.split("/");
        const clusterSlug = p[1];
        const slug = e.data.slug || p[p.length - 1].replace(/\.mdx$/, "");
        
        const clusterMod = Object.entries(clusterModules).find(([cPath]) => {
          const cleanCPath = cPath.replace(/\\/g, "/");
          const cp = cleanCPath.split("/");
          return (
            cp[cp.indexOf("learn") + 1] === hub &&
            cp[cp.indexOf("learn") + 2] === clusterSlug
          );
        });
        const rawClusterTitle =
          clusterMod?.[1]?.frontmatter?.title ||
          clusterSlug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
        const clusterTitle = rawClusterTitle.includes(":")
          ? rawClusterTitle.split(":")[0].trim()
          : rawClusterTitle;

        return {
          title: e.data.title,
          description: e.data.description || "",
          href: `/learn/${hub}/${clusterSlug}/${slug}`,
          clusterTitle,
          clusterSlug,
          publisheddate: e.data.publisheddate || "",
        };
      });

    return {
      params: { hub },
      props: {
        entry: mod,
        hub,
        clusters,
        totalArticleCount,
        recentArticles,
        hubIcon: hubMeta?.icon || "📚",
        hubDescription: hubMeta?.description || "",
      },
    };
  });
}

const { entry, hub, clusters, totalArticleCount, recentArticles, hubIcon, hubDescription } = Astro.props as {
  entry: MdxModule;
  hub: string;
  clusters: { slug: string; title: string; href: string; description: string; articleCount: number }[];
  totalArticleCount: number;
  recentArticles: { title: string; description: string; href: string; clusterTitle: string; clusterSlug: string; publisheddate: string }[];
  hubIcon: string;
  hubDescription: string;
};
const Content = entry.default;
const fm = entry.frontmatter ?? {};
---

<PillarLayout
  title={fm.seo?.title || fm.title || "Learn Hub"}
  description={fm.seo?.description || fm.description || hubDescription || ""}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn" },
    { name: fm.title || hub },
  ]}
  hubTitle={fm.title || hub}
  hubSlug={hub}
  hubIcon={hubIcon}
  hubDescription={hubDescription}
  clusters={clusters}
  totalArticleCount={totalArticleCount}
  recentArticles={recentArticles}
  publishedDate={fm.publisheddate}
  updatedDate={fm.updateddate}
>
  <Content />
</PillarLayout>