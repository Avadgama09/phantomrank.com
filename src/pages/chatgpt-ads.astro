---
import Layout from "../layouts/Layout.astro";
import Schema from "../components/seo/Schema.astro";
import DotBackground from "../components/ui/DotBackground.astro";
import { pageMeta } from "../utils/data";
import { Icon } from "astro-icon/components";

const meta = pageMeta["chatgpt-ads"] || {
  title: "ChatGPT Ads: Strategy, Setup & Management | PhantomRank",
  description:
    "ChatGPT Ads are now available in India. Learn how they work, how to target conversational intent, measure conversions and build a smarter AI advertising strategy.",
};

const indiaStats = [
  { value: "100M+", label: "Weekly ChatGPT users in India" },
  { value: "₹725", label: "Current minimum daily campaign budget in India" },
  { value: "40+", label: "Countries with ChatGPT Ads availability" },
  { value: "$1B", label: "Annualized ChatGPT Ads revenue run rate reported by OpenAI" },
];

const frameworkSteps = [
  { step: "01", title: "INTENT MAPPING", desc: "Map the questions, problems, comparisons and buying situations your customers have. Not just keywords. Customer situations." },
  { step: "02", title: "AI VISIBILITY", desc: "Understand how AI engines currently describe your brand — mentioned, recommended, cited, compared, overlooked, or inaccurately described." },
  { step: "03", title: "COMPETITIVE INTELLIGENCE", desc: "Understand which competitors appear for the same customer intents and what makes them visible." },
  { step: "04", title: "CONTEXT STRATEGY", desc: "Translate valuable customer situations into focused ChatGPT Ads ad groups and context hints." },
  { step: "05", title: "CREATIVE + LANDING PAGE", desc: "Build advertising and landing-page experiences that make sense for the context in which someone encounters the brand." },
  { step: "06", title: "MEASUREMENT", desc: "Connect the ad interaction to meaningful business outcomes — clicks, conversions, and revenue." },
  { step: "07", title: "OPTIMISATION", desc: "Improve the entire pipeline: Intent → Context → Creative → Landing Page → Conversion." },
];

const studioCapabilities = [
  {
    title: "STRATEGY",
    items: [
      "ChatGPT Ads opportunity assessment",
      "Customer intent mapping",
      "Buyer-situation research",
      "Competitive intent analysis",
      "Campaign planning",
      "Channel-fit assessment",
    ],
  },
  {
    title: "CAMPAIGN",
    items: [
      "Campaign architecture",
      "Ad group structure",
      "Context hint strategy",
      "Geographic targeting",
      "Platform targeting",
      "Audience strategy where applicable",
    ],
  },
  {
    title: "CREATIVE",
    items: [
      "Ad copy",
      "Value propositions",
      "Creative direction",
      "Testing frameworks",
      "Messaging variations",
    ],
  },
  {
    title: "LANDING PAGES",
    items: [
      "Landing page strategy",
      "Dedicated campaign pages",
      "Intent-aligned content",
      "Conversion optimisation",
      "Analytics implementation",
    ],
  },
  {
    title: "MEASUREMENT",
    items: [
      "OpenAI Pixel implementation",
      "Conversions API setup",
      "Conversion event configuration",
      "UTM strategy",
      "Analytics integration",
      "CRM measurement",
    ],
  },
  {
    title: "OPTIMISATION",
    items: [
      "Campaign monitoring",
      "Creative testing",
      "Context testing",
      "Conversion analysis",
      "Landing-page optimisation",
      "Performance reporting",
    ],
  },
];

const budgetFrameworks = [
  { title: "₹725/day", subtitle: "Minimum-entry experiment", desc: "Base daily requirement to launch a controlled campaign test in Ads Manager India." },
  { title: "₹1,500/day", subtitle: "Small structured test", desc: "Provides initial data density across 1–2 intent clusters." },
  { title: "₹3,000/day", subtitle: "More room for experimentation", desc: "Allows testing multiple context hints, ad groups, and creative variations." },
  { title: "₹5,000/day", subtitle: "High-volume testing", desc: "Useful when testing multiple variables with enough conversion volume to support optimization." },
];

const comparisonData = [
  { signal: "Core signal", google: "Search query", chatgpt: "Conversation context", meta: "Audience / behaviour signals" },
  { signal: "User mindset", google: '"I need this"', chatgpt: '"Help me figure this out"', meta: '"Show me something interesting"' },
  { signal: "Primary environment", google: "Search results", chatgpt: "Conversation", meta: "Social feed" },
  { signal: "Strongest opportunity", google: "Existing demand", chatgpt: "Exploration & consideration", meta: "Discovery" },
  { signal: "Targeting model", google: "Keywords + audiences", chatgpt: "Context + campaign targeting", meta: "Audiences + behaviour" },
  { signal: "Typical strength", google: "Bottom-funnel intent", chatgpt: "Decision context", meta: "Demand creation" },
  { signal: "Platform maturity", google: "Mature", chatgpt: "Emerging", meta: "Mature" },
  { signal: "Best approach", google: "Capture demand", chatgpt: "Understand & test context", meta: "Create / capture attention" },
];

const chatgptFaqs = [
  {
    question: "What are ChatGPT Ads?",
    answer: "ChatGPT Ads are sponsored advertisements that can appear below ChatGPT responses. They allow businesses to reach users while they explore, compare and make decisions in a conversational environment.",
  },
  {
    question: "Are ChatGPT Ads available in India?",
    answer: "Yes. OpenAI currently lists India as available for self-service Ads Manager access.",
  },
  {
    question: "How much do ChatGPT Ads cost in India?",
    answer: "The current minimum daily campaign budget for India is ₹725. Your recommended test budget will depend on your objectives, CPC, conversion rate and acceptable acquisition cost.",
  },
  {
    question: "Can I target keywords with ChatGPT Ads?",
    answer: "Not in the same way you would with traditional search advertising. Advertisers can provide context hints that describe relevant conversations, topics and situations. These hints help guide ad matching but are not exact-match keywords and do not guarantee delivery for a specific query.",
  },
  {
    question: "Do ChatGPT Ads influence ChatGPT's answers?",
    answer: "No. OpenAI says ads are clearly separated from ChatGPT's answers and advertising does not influence the answers ChatGPT provides.",
  },
  {
    question: "Can I pay to have ChatGPT recommend my company?",
    answer: "No. Paid advertising does not buy an organic recommendation from ChatGPT. Paid placements and organic answers are separate.",
  },
  {
    question: "How do you measure ChatGPT Ads?",
    answer: "Advertisers can use Ads Manager reporting together with conversion measurement tools such as the OpenAI Pixel and Conversions API, as well as UTM parameters and existing analytics or CRM systems.",
  },
  {
    question: "Are ChatGPT Ads better than Google Ads?",
    answer: "Not automatically. They operate in different environments. Google is highly effective at capturing explicit search demand, while ChatGPT creates an emerging opportunity to reach people during conversational exploration and decision-making. The right answer depends on your business and your measured acquisition economics.",
  },
  {
    question: "Should my business advertise on ChatGPT?",
    answer: "It may be worth testing if your customers research, compare or ask for recommendations before buying. We recommend starting with a controlled experiment rather than assuming the channel will outperform your existing advertising.",
  },
  {
    question: "Can PhantomRank help manage ChatGPT Ads?",
    answer: "Yes. PhantomRank Studio can support the strategy, campaign architecture, context strategy, creative, landing pages, measurement and optimisation required to test ChatGPT Ads properly.",
  },
];
---

<Layout
  metadata={{
    title: meta.title,
    description: meta.description,
    canonical: "https://www.phantomrank.com/chatgpt-ads/",
    ignoreTitleTemplate: true,
  }}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Studio", href: "/studio" },
    { name: "ChatGPT Ads", href: "/chatgpt-ads" },
  ]}
>
  <Fragment slot="head">
    <Schema
      type="Service"
      data={{
        service: {
          name: "ChatGPT Ads Strategy, Setup & Management",
          description:
            "Strategy, campaign architecture, context hints, landing pages, and conversion tracking for ChatGPT Ads in India and globally.",
          category: "AI Advertising & Search Marketing",
        },
      }}
    />
    <Schema
      type="FAQPage"
      data={{
        faqs: chatgptFaqs,
      }}
    />
  </Fragment>

  {/* ── 1. HERO SECTION ── */}
  <section
    class="relative mx-auto max-w-7xl px-4 pt-28 pb-16 sm:px-6 lg:px-8 min-h-[80vh] flex flex-col items-center justify-center overflow-hidden border-b border-border/40"
    id="chatgpt-ads-hero"
  >
    <DotBackground containerId="chatgpt-ads-hero" />

    <div class="text-center z-10 max-w-5xl mx-auto">
      <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs sm:text-sm font-medium text-primary uppercase tracking-wider">
        <Icon name="lucide:sparkles" class="h-4 w-4" />
        PHANTOMRANK STUDIO · CHATGPT ADS
      </div>

      <h1 class="reveal text-3xl sm:text-5xl lg:text-7xl font-medium tracking-tight text-foreground max-w-5xl mx-auto leading-tight">
        <span>ChatGPT Ads: Strategy, Setup & Management</span>
      </h1>

      <h2 class="reveal mt-6 text-xl sm:text-2xl lg:text-3xl font-medium bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent max-w-3xl mx-auto">
        Reach customers while they're exploring, comparing and deciding in ChatGPT.
      </h2>

      <p class="reveal mt-6 text-base sm:text-lg text-muted-foreground max-w-3xl mx-auto font-light leading-relaxed">
        ChatGPT Ads introduce a new kind of advertising environment — one built around conversations, context and the problems people are trying to solve. PhantomRank helps brands understand where ChatGPT Ads fit, map customer intent, build the right campaign structure, develop context strategies, create the advertising experience and measure what happens after the click.
      </p>

      <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/signup" class="btn-primary">
          Talk to PhantomRank
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
        <a href="#what-are-chatgpt-ads" class="btn-secondary">
          See how ChatGPT Ads work ↓
        </a>
      </div>

      <p class="reveal mt-6 text-xs text-muted-foreground/80 font-medium tracking-wider uppercase">
        AI Visibility + AI Advertising + Conversion Intelligence
      </p>

      {/* ChatGPT Ads Showcase Image */}
      <div class="reveal mt-12 max-w-4xl mx-auto rounded-2xl overflow-hidden border border-border/80 shadow-2xl">
        <img
          src="/images/image_compressed.webp"
          alt="ChatGPT Ads Interface and Targeting Concept"
          class="w-full h-auto object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>

  {/* ── 2. SECTION 01 — WHAT ARE CHATGPT ADS? ── */}
  <section id="what-are-chatgpt-ads" class="py-20 border-b border-border/40 scroll-mt-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <div class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">
          SECTION 01
        </div>
        <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-foreground mb-6">
          Advertising inside the AI decision experience
        </h2>

        <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed mb-6">
          People don't only use ChatGPT to find information. They use it to work through decisions.
        </p>

        <p class="text-sm text-foreground/90 font-medium mb-4">They ask:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          <blockquote class="p-4 rounded-xl bg-card border border-border text-xs text-foreground italic">
            "Which CRM should I use for my startup?"
          </blockquote>
          <blockquote class="p-4 rounded-xl bg-card border border-border text-xs text-foreground italic">
            "What's the best accounting software for a 20-person business?"
          </blockquote>
          <blockquote class="p-4 rounded-xl bg-card border border-border text-xs text-foreground italic">
            "Which laptop should I buy for video editing?"
          </blockquote>
          <blockquote class="p-4 rounded-xl bg-card border border-border text-xs text-foreground italic">
            "What should I consider before choosing a marketing agency?"
          </blockquote>
        </div>

        <p class="text-sm text-muted-foreground leading-relaxed mb-6">
          These conversations can contain much more context than a traditional search query. ChatGPT Ads give businesses an opportunity to appear as sponsored content while people are exploring those kinds of needs. Ads appear separately from ChatGPT's answers and are clearly labelled as sponsored.
        </p>

        <div class="p-6 rounded-2xl bg-primary/5 border border-primary/20 text-xs sm:text-sm text-muted-foreground leading-relaxed">
          <h3 class="font-bold text-foreground mb-2 flex items-center gap-2">
            <Icon name="lucide:info" class="w-4 h-4 text-primary" />
            The important distinction:
          </h3>
          <p>
            <strong class="text-foreground">You are not paying to influence what ChatGPT says.</strong> Advertising does not determine ChatGPT's organic answer. Instead, the advertising system evaluates whether an ad is relevant to the context in which someone is using ChatGPT. That creates a fundamentally different advertising environment from traditional search.
          </p>
        </div>
      </div>

      {/* ── VISUAL 01: FROM CONVERSATION TO CONVERSION ── */}
      <div class="reveal mt-16 p-8 rounded-3xl bg-card border border-border shadow-sm text-center">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-primary mb-6">
          VISUAL 01 · FROM CONVERSATION TO CONVERSION
        </h3>

        <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-medium text-foreground">
          <div class="p-4 rounded-xl bg-muted/40 border border-border w-full md:w-auto flex-1">
            USER CONVERSATION
          </div>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-primary shrink-0 rotate-90 md:rotate-0" />
          <div class="p-4 rounded-xl bg-muted/40 border border-border w-full md:w-auto flex-1">
            CONTEXT + INTENT
          </div>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-primary shrink-0 rotate-90 md:rotate-0" />
          <div class="p-4 rounded-xl bg-primary/10 border border-primary/30 text-primary font-bold w-full md:w-auto flex-1">
            RELEVANT SPONSORED AD
          </div>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-primary shrink-0 rotate-90 md:rotate-0" />
          <div class="p-4 rounded-xl bg-muted/40 border border-border w-full md:w-auto flex-1">
            LANDING PAGE
          </div>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-emerald-500 shrink-0 rotate-90 md:rotate-0" />
          <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 font-bold w-full md:w-auto flex-1">
            CONVERSION
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. SECTION 02 — CHATGPT ADS IN INDIA ── */}
  <section class="py-20 bg-muted/20 border-b border-border/40">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <div class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">
          SECTION 02
        </div>
        <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-foreground mb-6">
          Why ChatGPT Ads are suddenly interesting in India
        </h2>

        <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed mb-6">
          India is no longer a peripheral market for ChatGPT. OpenAI reported more than <strong class="text-foreground">100 million weekly ChatGPT users in India</strong> in February 2026. And as of September 2026, self-service ChatGPT Ads through Ads Manager is available in India.
        </p>

        <p class="text-sm text-muted-foreground leading-relaxed mb-6">
          The current minimum daily campaign budget in India is <strong class="text-foreground">₹725</strong>. That doesn't mean every business should start spending ₹725 a day tomorrow. It means the barrier to running a controlled experiment is now relatively low.
        </p>

        <div class="p-6 rounded-2xl bg-card border border-border mb-10">
          <h3 class="text-sm font-bold text-foreground mb-3">The bigger opportunity is the environment itself.</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            ChatGPT users often explain: what they are trying to accomplish, what they are comparing, what constraints they have, what they already know, what they are unsure about, and what they are considering buying. That creates an advertising environment where <strong class="text-foreground">context can matter as much as the category itself.</strong>
          </p>
        </div>
      </div>

      {/* INDIA STATS VISUAL */}
      <div class="reveal grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {indiaStats.map((stat) => (
          <div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
            <div class="text-3xl sm:text-4xl font-extrabold text-primary mb-2">
              {stat.value}
            </div>
            <p class="text-xs text-muted-foreground font-medium leading-normal">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
      <p class="reveal text-center text-[11px] text-muted-foreground/70 mt-4 italic">
        *Platform figures and availability change quickly. Verify current Ads Manager requirements before launching a campaign.
      </p>
    </div>
  </section>

  {/* ── 4. SECTION 03 — CHATGPT ADS ARE NOT GOOGLE ADS INSIDE CHATGPT ── */}
  <section class="py-20 border-b border-border/40">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <div class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">
          SECTION 03
        </div>
        <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-foreground mb-6">
          The biggest mistake marketers can make
        </h2>

        <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed mb-6">
          If you approach ChatGPT Ads by simply copying your Google Ads strategy, you're missing the interesting part. Google primarily gives advertisers a way to respond to <strong class="text-foreground">search queries</strong>. ChatGPT creates an environment where people can explain the <strong class="text-foreground">problem behind the query.</strong>
        </p>
      </div>

      {/* VISUAL 02: KEYWORDS -> CONVERSATIONS */}
      <div class="reveal my-10 grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Google Side */}
        <div class="bg-card border border-border p-6 rounded-2xl">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-400 mb-4">
            <Icon name="lucide:search" class="w-4 h-4" />
            GOOGLE
          </div>
          <div class="p-3.5 rounded-xl bg-muted/40 text-xs font-mono text-foreground mb-4">
            "best CRM for startups"
          </div>
          <p class="text-xs text-muted-foreground mb-3">A relatively compact search query. The advertiser thinks about:</p>
          <ul class="space-y-1.5 text-xs text-muted-foreground">
            <li>• Keywords</li>
            <li>• Bids</li>
            <li>• Match types</li>
            <li>• Search intent</li>
            <li>• Landing pages</li>
          </ul>
        </div>

        {/* ChatGPT Side */}
        <div class="bg-card border border-border p-6 rounded-2xl">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-400 mb-4">
            <Icon name="lucide:bot" class="w-4 h-4" />
            CHATGPT
          </div>
          <div class="p-3.5 rounded-xl bg-muted/40 text-xs font-mono text-foreground mb-4 leading-relaxed">
            "I'm running a 15-person startup. We're hiring salespeople and our spreadsheets are becoming a mess. What CRM should we use? We need something affordable and easy to implement."
          </div>
          <p class="text-xs text-muted-foreground mb-3">Now you have:</p>
          <ul class="grid grid-cols-2 gap-1.5 text-xs text-muted-foreground">
            <li>• Company size</li>
            <li>• Business stage</li>
            <li>• Problem</li>
            <li>• Trigger</li>
            <li>• Use case</li>
            <li>• Constraints</li>
            <li>• Buying intent</li>
          </ul>
        </div>
      </div>

      <div class="reveal p-6 rounded-2xl bg-card border border-border text-center">
        <p class="text-sm font-semibold text-foreground">
          The strategic unit is changing from the keyword to the customer situation.
        </p>
      </div>
    </div>
  </section>

  {/* ── 5. SECTION 04 — HOW CHATGPT ADS WORK ── */}
  <section class="py-20 bg-muted/20 border-b border-border/40">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="reveal text-center mb-12">
        <div class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">
          SECTION 04
        </div>
        <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-foreground">
          From campaign to conversion
        </h2>
        <p class="mt-3 text-base text-muted-foreground font-light max-w-xl mx-auto">
          The basic structure of a ChatGPT Ads campaign.
        </p>
      </div>

      <div class="reveal grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">01 — Campaign</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Define overall business objective, budget, dates, geography and other campaign-level settings.</p>
        </div>
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">02 — Ad Group</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Create focused themes around different products, use cases, value propositions or customer situations.</p>
        </div>
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">03 — Context Hints</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Describe the conversations, topics and situations where your product or service may be relevant.</p>
        </div>
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">04 — Ad</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Create headline, description, image/creative and landing page experience.</p>
        </div>
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">05 — Measurement</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Connect clicks and downstream conversion events through available measurement tools.</p>
        </div>
        <div class="bg-card border border-border p-6 rounded-2xl">
          <span class="text-xs font-bold text-primary block mb-2">06 — Optimisation</span>
          <p class="text-xs text-muted-foreground leading-relaxed">Use performance data to improve intent, context, creative and landing page combinations.</p>
        </div>
      </div>

      {/* VISUAL 03: CAMPAIGN STRUCTURE */}
      <div class="reveal p-8 rounded-3xl bg-card border border-border text-center shadow-sm mb-12">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-primary mb-6">
          VISUAL 03 · CHATGPT ADS CAMPAIGN STRUCTURE
        </h3>
        <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-medium text-foreground">
          <span class="px-4 py-2 rounded-xl bg-muted/40 border border-border">Campaign</span>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-primary" />
          <span class="px-4 py-2 rounded-xl bg-muted/40 border border-border">Ad Group</span>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-primary" />
          <span class="px-4 py-2 rounded-xl bg-primary/10 border border-primary/30 text-primary font-bold">Context Hints</span>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-primary" />
          <span class="px-4 py-2 rounded-xl bg-muted/40 border border-border">Ads</span>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-primary" />
          <span class="px-4 py-2 rounded-xl bg-muted/40 border border-border">Landing Page</span>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-emerald-500" />
          <span class="px-4 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 font-bold">Conversion</span>
        </div>
      </div>

      {/* Official YouTube Walkthrough Embed Section */}
      <div class="reveal bg-card border border-border rounded-3xl p-6 sm:p-8 text-center">
        <h3 class="text-lg font-bold text-foreground mb-2">See ChatGPT Ads Manager in action</h3>
        <p class="text-xs text-muted-foreground mb-6 max-w-xl mx-auto">
          Watch OpenAI's walkthrough of the Ads Manager interface, campaign setup, and context hints.
        </p>
