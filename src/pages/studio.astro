---
import Layout from "../layouts/Layout.astro";
import Schema from "../components/seo/Schema.astro";
import DotBackground from "../components/ui/DotBackground.astro";
import { pageMeta } from "../utils/data";
import { studioNavCategories, studioFAQs } from "../utils/studioData";
import { Icon } from "astro-icon/components";

const meta = pageMeta.studio || {
  title: "PhantomRank Studio — Search & AI Visibility Execution",
  description:
    "PhantomRank gives you the signal. Studio helps you act on it — websites, SEO, content, AI visibility and authority-building.",
};

const modelLogos = [
  { name: "ChatGPT", src: "/images/Logo/ChatGPTlogo.svg" },
  { name: "Claude", src: "/images/Logo/Claudelogo.svg" },
  { name: "Gemini", src: "/images/Logo/Gemini-ailogo.svg" },
  { name: "Grok", src: "/images/Logo/GROKlogo.svg" },
  { name: "Perplexity", src: "/images/Logo/Perplexitylogo.svg" },
];
---

<Layout
  metadata={{
    title: meta.title,
    description: meta.description,
    ignoreTitleTemplate: true,
  }}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Studio", href: "/studio" },
  ]}
>
  <Fragment slot="head">
    <Schema
      type="Service"
      data={{
        service: {
          name: "PhantomRank Studio Execution Services",
          description:
            "Execution services built around PhantomRank search intelligence — websites, technical SEO, content strategy, AI visibility optimisation, and authority distribution.",
          category: "Digital Marketing & AI Visibility Services",
        },
      }}
    />
  </Fragment>

  {/* ── 1. HERO SECTION ── */}
  <section
    class="relative mx-auto max-w-7xl px-4 pt-28 pb-16 sm:px-6 lg:px-8 min-h-[75vh] flex flex-col items-center justify-center overflow-hidden border-b border-border/40"
    id="studio-hero"
  >
    <DotBackground containerId="studio-hero" />

    <div class="text-center z-10 max-w-5xl mx-auto">
      <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs sm:text-sm font-medium text-primary uppercase tracking-wider">
        <Icon name="lucide:layers" class="h-4 w-4" />
        PHANTOMRANK STUDIO
      </div>

      <h1 class="reveal text-3xl sm:text-5xl lg:text-7xl font-medium tracking-tight text-foreground max-w-5xl mx-auto leading-tight">
        <span>PhantomRank gives you the signal.</span>
        <span class="block bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mt-2">
          Studio helps you act on it.
        </span>
      </h1>

      <p class="reveal mt-8 text-base sm:text-lg lg:text-xl text-muted-foreground max-w-3xl mx-auto font-light leading-relaxed">
        PhantomRank shows how your brand appears across AI search and recommendation engines. Studio is where we help with the work around it — websites, SEO, content, AI visibility and authority-building.
      </p>

      <div class="reveal mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#overview" class="btn-primary">
          Explore Studio
          <Icon name="lucide:arrow-down" class="w-4 h-4" />
        </a>
        <a href="/signup" class="btn-secondary">
          See PhantomRank
        </a>
      </div>
    </div>
  </section>

  {/* ── 2. BEYOND THE DASHBOARD BRIDGE ── */}
  <section class="py-16 bg-muted/20 border-b border-border/40">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="reveal max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-4xl font-medium tracking-tight text-foreground mb-4">
          Beyond the dashboard
        </h2>
        <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed">
          PhantomRank shows where you are being mentioned, cited, overlooked or misrepresented. Studio is for the work that follows — fixing the site, building the right pages, improving the information around your brand and tracking what changes.
        </p>
      </div>

      <div class="reveal bg-card border border-border rounded-3xl p-6 sm:p-8 max-w-4xl mx-auto shadow-sm">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-left">
          {/* Signal side */}
          <div class="flex-1 space-y-2">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
              <Icon name="lucide:activity" class="w-4 h-4" />
              PhantomRank Intelligence
            </div>
            <p class="text-sm font-medium text-foreground">
              Visibility, citations, competitors, source patterns, content gaps
            </p>
          </div>

          {/* Arrow divider */}
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center">
            <Icon name="lucide:arrow-right" class="w-5 h-5 rotate-90 md:rotate-0" />
          </div>

          {/* Execution side */}
          <div class="flex-1 space-y-2">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-500">
              <Icon name="lucide:wrench" class="w-4 h-4" />
              Studio Execution
            </div>
            <p class="text-sm font-medium text-foreground">
              Website, SEO, content, authority and ongoing optimisation
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. SERVICE NAVIGATION (OVERVIEW) ── */}
  <section id="overview" class="py-20 border-b border-border/40 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="reveal text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-foreground">
          What we can help with
        </h2>
        <p class="mt-3 text-base text-muted-foreground font-light max-w-xl mx-auto">
          Seven focused ways to turn search intelligence into visible commercial execution.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {studioNavCategories.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="reveal group bg-card border border-border p-6 rounded-2xl flex flex-col justify-between hover:border-primary/40 transition-all duration-200 shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl font-bold text-primary/30 group-hover:text-primary transition-colors">
                  {cat.number}
                </span>
                <Icon name="lucide:arrow-down-right" class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors" />
              </div>
              <h3 class="text-lg font-bold text-foreground mb-2 group-hover:text-primary transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {cat.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 4. DETAILED SERVICE SECTIONS ── */}
  <div class="divide-y divide-border/40">
    {/* 01. AI VISIBILITY & MODEL OPTIMISATION */}
    <section id="ai-visibility" class="py-20 scroll-mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">01</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              AI Visibility & Model Optimisation
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-8">
            PhantomRank shows how AI systems talk about your brand. Studio helps improve the information, pages and external signals behind those answers.
          </p>

          {/* Model Logos Strip */}
          <div class="mb-10 p-6 rounded-2xl bg-card border border-border">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/80 mb-4 text-center">
              Model Coverage & Retrieval Optimisation Across:
            </p>
            <div class="flex flex-wrap items-center justify-center gap-8 opacity-80 transition-all duration-300 hover:opacity-100">
              {modelLogos.map((logo) => (
                <div class="flex items-center gap-2">
                  <img src={logo.src} alt={logo.name} class="h-6 w-auto brightness-0 dark:brightness-100" />
                  <span class="text-xs font-medium text-foreground">{logo.name}</span>
                </div>
              ))}
            </div>
            <p class="mt-5 text-xs text-muted-foreground leading-relaxed text-center max-w-2xl mx-auto">
              We can run model-specific visibility work where it matters — from improving retrieval-ready source material and RAG-friendly content structure, to clearer entity signals, better comparison content and stronger third-party source coverage.
            </p>
          </div>

          {/* Scope list */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div class="bg-card border border-border p-6 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-4">
                PhantomRank Intelligence Integration
              </h3>
              <ul class="space-y-2.5 text-xs text-muted-foreground">
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>AI visibility audits & mention/citation analysis</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>Crawled-but-not-cited page review & diagnostics</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>Brand-description and messaging alignment</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>AI competitor analysis & Share of Voice / Synthesis</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>Information-gap and citation-gap research</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary font-semibold">•</span>
                  <span>Source-domain and source-ecosystem analysis</span>
                </li>
              </ul>
            </div>

            <div class="bg-card border border-border p-6 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-4">
                Execution Scope & Structural Work
              </h3>
              <ul class="space-y-2.5 text-xs text-muted-foreground">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>Website and content structure optimization</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>Entity clarity & JSON-LD schema enrichment</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>Citation-ready source material development</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>Comparison & buyer decision content builds</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>Relevant third-party source & profile seeding</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-semibold">•</span>
                  <span>AI-search reporting and ongoing monitoring</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- ChatGPT Ads Featured Service Link -->
          <div class="my-6 p-4 rounded-2xl bg-gradient-to-r from-blue-500/10 via-purple-500/10 to-pink-500/10 border border-primary/20 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 text-xs font-semibold text-primary uppercase tracking-wider mb-1">
                <Icon name="lucide:sparkles" class="w-4 h-4" />
                Featured Service · Paid AI Visibility
              </div>
              <h4 class="text-sm font-bold text-foreground">ChatGPT Ads: Strategy, Setup & Management</h4>
              <p class="text-xs text-muted-foreground">Reach buyers while they explore, compare and decide inside ChatGPT conversations in India & globally.</p>
            </div>
            <a href="/chatgpt-ads/" class="btn-primary shrink-0 text-xs py-2 px-4">
              Explore ChatGPT Ads
              <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>

          <div class="flex items-center justify-between pt-4">
            <a href="/learn/ai-visibility-tracking" class="text-xs text-primary hover:underline inline-flex items-center gap-1">
              <span>Read our AI visibility guide in the content hub</span>
              <Icon name="lucide:arrow-right" class="w-3 h-3" />
            </a>
            <a href="/signup" class="btn-ghost text-xs">Request AI Visibility Audit</a>
          </div>
        </div>
      </div>
    </section>

    {/* 02. WEBSITES & CONVERSION */}
    <section id="websites-conversion" class="py-20 scroll-mt-24 bg-muted/20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">02</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              Websites & Conversion
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-8">
            We design and build the pages people actually use to decide whether to contact, enquire or buy from you.
          </p>

          <div class="bg-card border border-border p-6 rounded-2xl mb-8">
            <h3 class="text-sm font-bold text-foreground mb-4">Web Development & Technical Foundations</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-muted-foreground">
              <li>• One-page & brochure websites</li>
              <li>• Service & SaaS marketing sites</li>
              <li>• Ecommerce & product pages</li>
              <li>• Landing pages & city pages</li>
              <li>• Full website redesigns</li>
              <li>• CMS setup & headless builds</li>
              <li>• Core Web Vitals & speed performance</li>
              <li>• Mobile-first implementation</li>
              <li>• Technical SEO foundations</li>
              <li>• Website copy & brand messaging</li>
              <li>• Forms, CRM & WhatsApp integrations</li>
              <li>• Ongoing website support & updates</li>
            </ul>
          </div>

          {/* Selected Work Showcase */}
          <div class="p-8 rounded-2xl bg-card border border-border/80 text-center">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
              <Icon name="lucide:layout-grid" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-foreground mb-2">
              Featured Studio Website Builds
            </h3>
            <p class="text-xs text-muted-foreground max-w-xl mx-auto mb-6">
              Modern, high-performance web architecture engineered for fast page loads, schema indexation, and conversion.
            </p>
            <div class="inline-flex items-center gap-2 text-xs text-muted-foreground bg-muted/40 px-4 py-2 rounded-full border border-border">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>All builds include technical SEO, responsive layouts & core analytics</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 03. SEO */}
    <section id="seo" class="py-20 scroll-mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">03</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              SEO
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-4">
            SEO is a mix of technical work, content work, local visibility and authority-building. We choose the work based on the actual site and market, not a fixed checklist.
          </p>

          <p class="text-xs text-primary font-semibold mb-8">
            There are many kinds of SEO work. We identify which ones actually matter for your business.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-card border border-border p-5 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-3">Platform & CMS SEO</h3>
              <ul class="space-y-2 text-xs text-muted-foreground">
                <li>• Shopify & E-commerce SEO</li>
                <li>• WordPress & Webflow SEO</li>
                <li>• Next.js & React SSR SEO</li>
              </ul>
            </div>

            <div class="bg-card border border-border p-5 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-3">Next-Gen Search & Discovery</h3>
              <ul class="space-y-2 text-xs text-muted-foreground">
                <li>• Reddit & Community Search SEO</li>
                <li>• Parasite SEO & Publisher Network Growth</li>
                <li>• AI Engine Optimization (GEO/AEO)</li>
                <li>• Google Discover & News SEO</li>
              </ul>
            </div>

            <div class="bg-card border border-border p-5 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-3">Scale & Automation</h3>
              <ul class="space-y-2 text-xs text-muted-foreground">
                <li>• Programmatic SEO (pSEO)</li>
                <li>• Semantic Content Clusters</li>
              </ul>
            </div>

            <div class="bg-card border border-border p-5 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-3">Foundational Retainers</h3>
              <ul class="space-y-2 text-xs text-muted-foreground">
                <li>• Technical Architecture & Core Web Vitals</li>
                <li>• Google Maps & Local Visibility</li>
                <li>• Digital PR & Editorial Outreach</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 04. CONTENT STRATEGY & PRODUCTION */}
    <section id="content-strategy" class="py-20 scroll-mt-24 bg-muted/20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">04</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              Content Strategy & Production
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-4">
            We plan and create the pages that help customers understand, compare and choose your business.
          </p>

          <div class="p-3 rounded-xl bg-primary/5 border border-primary/20 text-xs text-primary font-semibold mb-8 inline-flex items-center gap-2">
            <Icon name="lucide:check-circle" class="w-4 h-4" />
            AI-assisted drafting, with human editing, review and fact-checking.
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-card border border-border p-6 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-4">Strategy & Planning</h3>
              <ul class="space-y-2.5 text-xs text-muted-foreground">
                <li>• Content audits & editorial calendars</li>
                <li>• Topic clusters & search question research</li>
                <li>• Buyer-journey content mapping</li>
                <li>• Detailed content briefs & internal linking</li>
              </ul>
            </div>

            <div class="bg-card border border-border p-6 rounded-2xl">
              <h3 class="text-sm font-bold text-foreground mb-4">Page & Asset Creation</h3>
              <ul class="space-y-2.5 text-xs text-muted-foreground">
                <li>• Service, product, use-case & industry pages</li>
                <li>• Comparison, alternative & pricing pages</li>
                <li>• Blog articles, pillar guides & FAQs</li>
                <li>• Case studies & founder thought leadership</li>
                <li>• Schema-ready content & FAQ markup</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 05. AUTHORITY, DISTRIBUTION & SEEDING */}
    <section id="authority-distribution" class="py-20 scroll-mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">05</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              Authority, Distribution & Seeding
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-8">
            Your website is only one part of the information people and AI systems use. We help strengthen the relevant sources around it.
          </p>

          <div class="bg-card border border-border p-6 rounded-2xl">
            <h3 class="text-sm font-bold text-foreground mb-4">Credible Source & Distribution Scope</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-muted-foreground">
              <li>• Source-domain mapping</li>
              <li>• Citation ecosystem research</li>
              <li>• Content-seeding strategy</li>
              <li>• Directory & listing optimisation</li>
              <li>• Review-platform presence</li>
              <li>• Marketplace & founder profiles</li>
              <li>• Reddit & Quora community strategy</li>
              <li>• Digital PR & editorial outreach</li>
              <li>• Relevant third-party placements</li>
              <li>• Unlinked brand mention recovery</li>
              <li>• External source brand consistency</li>
              <li>• Launch & content distribution support</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 06. RESEARCH & GROWTH STRATEGY */}
    <section id="research-strategy" class="py-20 scroll-mt-24 bg-muted/20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">06</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              Research & Growth Strategy
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed max-w-3xl mb-8">
            Before building pages or publishing content, we work out what matters, where the gaps are and what should happen first.
          </p>

          <div class="bg-card border border-border p-6 rounded-2xl">
            <h3 class="text-sm font-bold text-foreground mb-4">Growth Intelligence & Prioritisation Scope</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-muted-foreground">
              <li>• Keyword research & search intent</li>
              <li>• Customer-question research</li>
              <li>• Buyer journeys & buying criteria</li>
              <li>• Market & category research</li>
              <li>• Competitor content & authority gaps</li>
              <li>• Website & conversion review</li>
              <li>• Positioning & brand messaging</li>
              <li>• Local & regional opportunity research</li>
              <li>• SEO & content roadmaps</li>
              <li>• AI visibility action plans</li>
              <li>• Prioritisation frameworks</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 07. TRACKING, REPORTING & ADVISORY */}
    <section id="tracking-advisory" class="py-20 scroll-mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-lg font-bold text-primary/50">07</span>
            <h2 class="text-3xl font-medium tracking-tight text-foreground">
              Tracking, Reporting & Advisory
            </h2>
          </div>

