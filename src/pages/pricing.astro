---
import Layout from "../layouts/Layout.astro";
import PricingSection from "../components/sections/Pricing.astro";
import { pageMeta } from "../utils/data";

const meta = pageMeta.pricing;
---

<Layout
  title={meta.title}
  description={meta.description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Pricing", href: "/pricing" },
  ]}
>
  <PricingSection variant="full" />

  <div class="reveal max-w-2xl mx-auto text-center py-16">
    <h2 class="text-3xl font-bold mb-4">Get a Custom Pricing Quote</h2>
    <p class="text-lg text-muted-foreground mb-6">
      Our plans are tailored to your agency’s needs. Contact us and we’ll work out the best package for you.
    </p>
    <a href="/signup" class="rounded-full bg-primary px-8 py-3.5 text-sm font-semibold text-white transition-all hover:bg-primary/80 hover:shadow-lg hover:shadow-primary/25">
      Contact Us
    </a>
  </div>
</Layout>
