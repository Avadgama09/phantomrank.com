---
import Layout from "../layouts/Layout.astro";
import Schema from "../components/seo/Schema.astro";
import Hero from "../components/sections/Hero.astro";
import Problem from "../components/sections/Problem.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Workflow from "../components/sections/Workflow.astro";
import Features from "../components/sections/Features.astro";
import SocialProof from "../components/sections/SocialProof.astro";
import FAQ from "../components/sections/FAQ.astro";
import CTA from "../components/sections/CTA.astro";
import * as data from "../utils/data";
const { pageMeta, faqs } = data;

const meta = pageMeta.home;
---

<Layout
  metadata={{
    title: meta.title,
    description: meta.description,
    ignoreTitleTemplate: true,
  }}
>
  <Fragment slot="head">
    <meta name="trustpilot-one-time-domain-verification-id" content="4ea1a2a5-9a7f-4675-a639-460dcceae84b" />
    <Schema type="SoftwareApplication" data={{}} />
    <Schema type="Service" data={{
      service: {
        name: "AI Brand Visibility Monitoring",
        description: "Track how your brand is mentioned and cited across ChatGPT, Gemini, Claude, Perplexity, and Grok. PhantomRank monitors AI share of voice, citation frequency, and brand sentiment across 28 AI model variants.",
        category: "AI Search Intelligence"
      }
    }} />
    <Schema type="FAQPage" data={{ faqs }} />
  </Fragment>

  <!-- Scene 1: The World Changed -->
  <Hero />

  <!-- Scene 2: You're Invisible -->
  <Problem />

  <!-- Scene 3: Here's Why (The AI Search Stack) -->
  <HowItWorks />

  <!-- Scene 4: The Discovery Workflow -->
  <Workflow />

  <!-- Scene 5: Imagine Using It (The Reveal) -->
  <Features />

  <!-- Scene 6: Evidence -->
  <SocialProof />

  <!-- Scene 7: Clarification -->
  <FAQ />

  <!-- Scene 8: Let's Start -->
  <CTA />
</Layout>
