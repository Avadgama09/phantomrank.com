    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-foreground">Methodology in plain language</h2>
    </div>
    
    <div class="relative">
      {/* Horizontal Line for Desktop */}
      <div class="hidden md:block absolute top-10 left-8 right-8 h-1 bg-border rounded-full"></div>
      
      <div class="grid md:grid-cols-6 gap-6 md:gap-4 relative z-10">
        {howItWorks.map((step, index) => (
          <div class="group relative flex md:flex-col items-start md:items-center gap-4 md:gap-3">
            {/* Connecting line for mobile */}
            {index !== howItWorks.length - 1 && (
              <div class="md:hidden absolute left-5 top-12 bottom-[-1.5rem] w-px bg-border"></div>
            )}
            
            <div class="w-10 h-10 shrink-0 rounded-full bg-card border-2 border-primary flex items-center justify-center text-primary font-bold shadow-md z-10 transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
              {index + 1}
            </div>
            
            <div class="pt-2 md:pt-0 md:text-center w-full">
               <h3 class="font-bold text-foreground text-sm mb-1">{step.title}</h3>
               {/* Mobile: visible. Desktop: visible on hover (opacity/translate trick) or just keep it minimal */}
               <p class="text-xs text-muted-foreground md:opacity-0 md:-translate-y-2 md:group-hover:opacity-100 md:group-hover:translate-y-0 transition-all duration-300 md:absolute md:w-48 md:left-1/2 md:-translate-x-1/2 md:mt-2 md:bg-card md:border md:border-border md:p-3 md:rounded-lg md:shadow-xl pointer-events-none z-20">
                 {step.desc}
               </p>
            </div>
          </div>
        ))}
      </div>
      
      {/* Desktop instructional subtext */}
      <div class="hidden md:block text-center mt-32 text-xs font-bold uppercase tracking-wider text-muted-foreground">
