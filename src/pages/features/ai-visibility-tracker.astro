        <thead class="bg-muted/30 border-b border-border">
          <tr>
            <th class="px-6 py-4 font-bold text-foreground">Category</th>
            <th class="px-6 py-4 font-bold text-foreground">Metric name</th>
            <th class="px-6 py-4 font-bold text-foreground">What it measures</th>
            <th class="px-6 py-4 font-bold text-foreground">Why it matters</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {metricsData.map((row) => (
            <tr class="hover:bg-white/5 transition-colors">
              <td class="px-6 py-4 font-bold text-muted-foreground text-xs uppercase tracking-wider">{row.category}</td>
              <td class="px-6 py-4 font-bold text-foreground">{row.name}</td>
              <td class="px-6 py-4 text-muted-foreground leading-relaxed">{row.measures}</td>
              <td class="px-6 py-4 font-medium text-foreground leading-relaxed">{row.matters}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ── 6. METHODOLOGY (TIMELINE) ── */}
