---
import Layout from "../../layouts/Layout.astro";
import FeatureDetail from "../../components/sections/FeatureDetail.astro";
import CTA from "../../components/sections/CTA.astro";
import FAQ from "../../components/sections/FAQ.astro";
import { features } from "../../utils/features";

const feature = features.find((f) => f.slug === "ai-visibility-tracker")!;

const insight =
  "When someone asks ChatGPT, Perplexity, or Gemini for “best tools in my category”, the AI returns 3–4 options and the rest of the market disappears. Traditional SEO tools can’t tell you if you were even in the running, how you were described, or whether you were recommended at all. PhantomRank’s AI Visibility Tracker turns those messy, non‑deterministic answers into a stable picture of where you show up, how you’re framed, and which levers to pull to move real demand in your direction.";

const outputs = [
  "Answer State Map showing, for each intent cluster, whether your brand is absent, mentioned, recommended, or strongly endorsed across major AI engines.",
  "Multi‑engine coverage report aggregating results from Perplexity (live) and, as we roll them out, ChatGPT, Gemini, Claude, and Copilot — so you’re not basing decisions on a single assistant.",
  "AI Discovery Funnel that tracks the journey from query → your pages being crawled → your brand being mentioned → your site actually being cited, so you can see exactly where visibility breaks.",
  "Trust Gap detection — prompts where AI crawled your content but chose not to cite it, revealing high‑ROI fixes where the content exists but isn’t yet “good enough” for the answer.",
  "Visibility by Platform breakdown showing how each assistant treats you, so you can compare, for example, Perplexity vs ChatGPT recommendations for the same buyer intent.",
  "Visibility Breakdown across four categories: Fully Visible, Cited Only, Trust Gap, and Not Found — a simple, non‑deterministic‑safe way to track change over time.",
  "Competitor overlap analysis showing which competitors appear when you don’t, and in which intents they beat you (budget, quality, scale, niche, etc.).",
  "Auto‑generated Key Insights that translate the data into plain next steps: pages to improve, queries to own, review surfaces to strengthen, and communities to seed.",
];

const howItWorks = [
  "Brief Builder — Start with a structured brief instead of a keyword dump. Enter brand name, website, industry, up to 3 competitors, customer type (B2B/B2C/D2C), target buyer roles, up to 5 use cases, and up to 5 differentiators. Choose between Organic prompts (no brand name; see where you deserve to appear) and Brand‑centric prompts (measure current visibility). The brief auto‑saves so you can refine it over time.",
  "Intent‑based Prompt Generation — PhantomRank generates 45 strategic prompts across 9 funnel‑aligned intent types: Category Awareness, Recommendation, Problem‑Solution, Comparison/Versus, Brand‑Direct, Use‑Case Specific, Local/Regional, Alternatives/Substitutes, and Trust Validation. For each, you can choose from 6 query styles — Conversational, Formal Question, Command, Keyword‑Dense, Context‑Heavy, or Comparison — to mirror how real buyers actually ask.",
  "Review & Customize — Before any AI call is made, you review all prompts grouped by intent. You can select, deselect, edit, delete, or add your own custom prompts. This keeps the methodology transparent: you always know which questions we’re asking on your behalf.",
  "Multi‑Engine Analysis Run — Select the AI platforms to query (Perplexity live; ChatGPT, Gemini, Claude, and Copilot rolling out), confirm your prompt set, and launch the run. We execute prompts in parallel, log which pages each engine crawls, and normalize the responses into a standard format. A real‑time progress view shows how many prompts have completed and what’s left.",
  "Answer State & Funnel Modeling — For each intent cluster, PhantomRank classifies the outcome into four answer states: Absent, Mentioned, Recommended, and Strongly Endorsed. In parallel, we build an AI Discovery Funnel from query → crawl pool → mention → citation. This is how we handle non‑determinism: by tracking patterns and states over multiple prompts and engines, not pretending every answer is identical.",
  "Results Dashboard — The dashboard is split into three lenses. Overview shows your answer state distribution, AI Discovery Funnel, per‑platform coverage, and auto‑generated insights. Detailed Results lets you inspect each prompt with citation status, crawled URLs, and context snippets. Competitor View highlights which brands show up when you don’t, and in which intents they dominate.",
];

const useCases = [
  {
    scenario: "Pitching a new SEO or AI visibility client",
    outcome:
      "Run a full visibility audit before the first call. Show where they’re completely absent in AI answers, where competitors are recommended instead, and which trust gaps are easiest to fix. You walk into the pitch with a narrative and screenshots they’ve never seen before.",
  },
  {
    scenario: "Monthly client reporting",
    outcome:
      "Move beyond vague comments like “AI seems to like us more.” Report concrete shifts in answer states, mention rates, trust gaps, and competitor visibility. Export prompt‑level CSVs into your existing decks and show how content and review work is changing what AIs actually say.",
  },
  {
    scenario: "Content and SEO strategy prioritization",
    outcome:
      "Use Trust Gap detection to find queries where AI already crawls your client’s content but chooses not to cite it. These become your highest‑ROI fixes — pages where structural changes, better schema, or clearer positioning can unlock immediate AI visibility without net‑new articles.",
  },
  {
    scenario: "Competitive intelligence and category mapping",
    outcome:
      "See which competitors get recommended for which intents — budget, quality, scale, niche — and how AIs describe their strengths. Use this to refine your client’s positioning, decide which battles to fight, and identify categories where you can realistically become the default recommendation.",
  },
  {
    scenario: "Brand vs. Organic prompt testing",
    outcome:
      "Run one Organic analysis (no brand name) and one Brand‑centric analysis (brand included) to compare where you deserve to appear vs. where you actually appear. Quantify the visibility gap and use it to prioritize content, PR, and review investments.",
  },
  {
    scenario: "Multi‑market and multi‑segment expansion",
    outcome:
      "Test visibility across geos and segments — for example, Mumbai vs US, or Fintech vs SaaS. See how different assistants recommend your client in each context and plan which markets to prioritize based on where AI already sees you as a fit.",
  },
];

const includes = [
  "9 funnel‑aligned intent types covering the full journey from Category Awareness to Brand‑Direct and Trust Validation.",
  "45 AI‑generated prompts per brand analysis, with full edit control before anything is sent to AI.",
  "6 query styles to mirror real buyer behaviour (Conversational, Formal Question, Command, Keyword‑Dense, Context‑Heavy, Comparison).",
  "Organic and Brand‑centric prompt modes to compare “where you should appear” vs “where you actually appear”.",
  "Up to 3 competitor benchmarks per analysis, baked into the same prompt set and time window.",
  "Per‑prompt mention and citation tracking, including crawled URLs and context snippets.",
  "Answer State classification for each intent cluster (Absent, Mentioned, Recommended, Strongly Endorsed).",
  "AI Discovery Funnel visualisation to see where in the chain (crawl, mention, citation) you’re dropping out.",
  "Trust Gap detection and scoring to highlight high‑leverage content fixes.",
  "Auto‑generated, human‑editable insights that translate data into concrete next steps.",
  "CSV export for prompt‑level and summary data, ready for client decks and internal reporting.",
  "Scheduling support for recurring runs (e.g., weekly tracking) so you can see trends instead of one‑off snapshots.",
];

const faqs = [
  {
    question: "How is your AI visibility tracking different from black‑box tools?",
    answer: "PhantomRank doesn’t hide a secret sampling recipe. Every scan is co-designed with you: we start by drafting a brand DNA from your site and name, your team edits it, we generate buyer personas and journeys, you choose and adjust stages and intents, and you can rewrite every prompt in your own buyer language. Finally, you decide which models to hit and we log the exact versions and geo. Our job is to make that test repeatable and readable, not to pick prompts for you behind the scenes."
  },
  {
    question: "Can I control which prompts and personas PhantomRank uses to test visibility?",
    answer: "Yes. We propose personas and journeys from your brand DNA, but nothing is locked. You can select which personas matter, which stages of the journey to include, and edit or replace every prompt so it matches how your buyers actually speak. PhantomRank then reuses that set consistently, so trends over time reflect real changes, not our guesswork."
  },
  {
    question: "How do you handle AI engines giving different answers to the same prompt?",
    answer: "We treat each engine as a separate surface. For every prompt set, PhantomRank queries ChatGPT, Gemini, Claude, Grok, Perplexity and Copilot in parallel, logs the model versions, and compares visibility at three layers: mention, recommendation, and citation. Instead of pretending there’s a single ‘true’ answer, we show you how each engine talks about you and where you’re strong or weak."
  },
  {
    question: "What exactly do you track in an AI answer?",
    answer: "We track whether you’re named, whether you’re recommended as a pick, whether your domain is cited, and whether your pages are in the crawl pool but rejected. We also capture which non‑you sources got cited alongside or instead of you, so you see the full competitive and ecosystem context—not just your own score."
  },
  {
    question: "Can we limit scans to India or specific regions?",
    answer: "Yes. Location is explicit, not implied. We inject geo parameters into our prompt templates and log them with each run, so you can see how visibility differs for India versus other regions and avoid mixing local and global results in the same charts."
  }
];
---

<Layout
  title="AI Visibility Tracker — See How AIs Talk About Your Brand | PhantomRank"
  description="Turn AI answers into a stable, decision‑grade view of where your client shows up, how they’re framed, and where competitors are winning. Built for agencies that need more than screenshots."
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Features", href: "/features" },
    { name: "AI Visibility Tracker", href: "/features/ai-visibility-tracker" },
  ]}
>
  <FeatureDetail
    feature={feature}
    insight={insight}
    outputs={outputs}
    howItWorks={howItWorks}
    useCases={useCases}
    includes={includes}
  >
    <div slot="hero-image" class="mockup-window border border-border bg-muted/30">
      <div class="bg-background border-t border-border">
        <img
          src="/images/features/ai-visibility-tracker/Persona1.webp"
          alt="Persona Analysis"
          class="w-full h-auto"
        />
      </div>
    </div>

    <div slot="workflow-image" class="mockup-window border border-border bg-muted/30">
      <div class="bg-background border-t border-border">
        <img
          src="/images/features/ai-visibility-tracker/Intent.webp"
          alt="Intent Mapping"
          class="w-full h-auto"
        />
      </div>
    </div>
  </FeatureDetail>
  <FAQ customFaqs={faqs} title="AI Visibility Tracker — FAQs" subtitle="Focus: methodology, non‑determinism, prompts, multi‑engine runs." />
  <CTA />
</Layout>
