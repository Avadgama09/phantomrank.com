---
// src/layouts/ArticleLayout.astro — Article page with sibling-articles sidebar + full schema
import Layout from "./Layout.astro";
import Schema from "../components/seo/Schema.astro";

interface SiblingArticle {
  slug: string;
  title: string;
  href: string;
}

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { name: string; href?: string }[];
  hubTitle: string;
  hubSlug: string;
  clusterTitle: string;
  clusterSlug: string;
  siblingArticles: SiblingArticle[];
  currentArticle: string;
  totalArticles: number;
  // Schema fields
  datePublished?: string;
  dateModified?: string;
  featuredImage?: string;
  relatedLinks?: RelatedLink[];
}

const {
  title,
  description,
  breadcrumbs,
  hubTitle,
  hubSlug,
  clusterTitle,
  clusterSlug,
  siblingArticles,
  currentArticle,
  totalArticles,
  datePublished,
  dateModified,
  featuredImage,
  relatedLinks,
} = Astro.props;

const displayedArticles = siblingArticles.slice(0, 5);
const hasMore = totalArticles > 5;

const clusterUrl = `/learn/${hubSlug}/${clusterSlug}`;
const pillarUrl = `/learn/${hubSlug}`;
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
  <Schema
    slot="head"
    type="Article"
    data={{
      article: {
        title,
        description,
        datePublished: datePublished ? new Date(datePublished).toISOString() : undefined,
        dateModified: dateModified
          ? new Date(dateModified).toISOString()
          : datePublished
          ? new Date(datePublished).toISOString()
          : undefined,
        image: featuredImage,
        clusterUrl,
        clusterTitle,
        pillarUrl,
        pillarTitle: hubTitle,
        relatedLinks,
        speakableSelectors: [".article-intro", "article h2 + p", "article h3 + p"],
      },
    }}
  />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <a
      href={`/learn/${hubSlug}/${clusterSlug}`}
      class="mb-8 inline-flex items-center text-sm font-medium text-muted-foreground transition-colors hover:text-primary"
    >
      <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to {clusterTitle}
    </a>

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">
      <article
        class="article-body min-w-0 overflow-x-auto prose prose-lg max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground
          prose-p:text-muted-foreground prose-p:leading-8
          prose-a:text-primary prose-a:no-underline hover:prose-a:underline
          prose-strong:text-foreground
          prose-li:text-muted-foreground
          prose-blockquote:border-primary/40 prose-blockquote:text-muted-foreground
          prose-code:rounded prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:text-primary
          prose-pre:overflow-x-auto
          prose-table:text-sm
          prose-th:font-semibold prose-th:text-foreground
          prose-td:text-muted-foreground
          prose-img:rounded-xl prose-img:shadow-md
          prose-hr:border-border"
      >
        <slot />
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-4">
          <!-- Sibling articles navigation -->
          <div class="rounded-2xl border border-border bg-background/60 p-6">
            <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              More in {clusterTitle}
            </h3>
            <nav class="mt-4 flex flex-col gap-1">
              {displayedArticles.map((article) => (
                <a
                  href={article.href}
                  class:list={[
                    "rounded-md px-3 py-2 text-sm transition-colors",
                    article.slug === currentArticle
                      ? "bg-primary/10 font-medium text-primary"
                      : "text-muted-foreground hover:bg-muted hover:text-foreground",
                  ]}
                >
                  {article.title}
                </a>
              ))}
            </nav>

            {hasMore && (
              <a
                href={`/learn/${hubSlug}/${clusterSlug}`}
                class="mt-4 inline-flex items-center text-sm font-medium text-primary hover:underline"
              >
                View all {totalArticles} articles
                <svg class="ml-1 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            )}
          </div>

          <!-- Hierarchy navigation -->
          <div class="rounded-2xl border border-border bg-background/60 p-5 space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
              Series
            </h3>
            <a
              href={clusterUrl}
              class="flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors"
            >
              <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              {clusterTitle}
            </a>
            <a
              href={pillarUrl}
              class="flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors"
            >
              <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              {hubTitle}
            </a>
            <a
              href="/learn"
              class="flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors"
            >
              <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              All Series
            </a>
          </div>

          <!-- Related links from frontmatter -->
          {relatedLinks && relatedLinks.length > 0 && (
            <div class="rounded-2xl border border-border bg-background/60 p-5">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
                Related reading
              </h3>
              <nav class="flex flex-col gap-1">
                {relatedLinks.map((link) => (
                  <a
                    href={link.href}
                    class="text-sm text-muted-foreground hover:text-primary hover:bg-muted rounded-md px-2 py-1.5 transition-colors line-clamp-2"
                  >
                    {link.label}
                  </a>
                ))}
              </nav>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>
